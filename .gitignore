# =============================================================
# Royal Travel Agency – Root .gitignore
# Covers: admin-app (Vite), web-app (Next.js), mobile-app (Expo)
# =============================================================

# ───────────── Dependencies ─────────────
node_modules/
**/node_modules/

# Yarn PnP
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ───────────── Local Environment (secrets) ─────────────
.env*
**/.env*
# Allow example env templates
!**/.env.example

# ───────────── Build Outputs ─────────────
dist/
**/dist/
build/
**/build/
bin/
**/bin/
out/
**/out/

# Next.js
.next/
**/.next/

# Expo / React Native
.expo/
**/.expo/
web-build/
**/web-build/
expo-env.d.ts
**/expo-env.d.ts

# Android / iOS (generated by Expo managed workflow)
/mobile-app/ios/
/mobile-app/android/build/

# ───────────── Vercel ─────────────
.vercel/
**/.vercel/

# ───────────── TypeScript ─────────────
*.tsbuildinfo
next-env.d.ts

# ───────────── IDE & Editor ─────────────
.vscode/
**/.vscode/
.idea/
**/.idea/
.project
.classpath
.settings/
*.swp
*.swo
.eslintcache

# ───────────── Logs ─────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ───────────── System Files ─────────────
.DS_Store
Thumbs.db
*.pem

# ───────────── Keys & Certificates ─────────────
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.com.apple.InterfaceBuilder.v3.plist
eas-build-err.txt

# ───────────── Testing / Coverage ─────────────
coverage/
**/coverage/
.metro-health-check*

# ───────────── Scratch / Temp Files ─────────────
scratch/
**/scratch/
build_output.txt

# ───────────── Database Dumps ─────────────
seed.sql
**/seed.sql
seed.sql.bak
**/seed.sql.bak
seed_clean.sql
**/seed_clean.sql

# ───────────── Runtime-generated / Dev-only ─────────────
agent.md
**/agent.md
generated_titles.json
titles.json

# ───────────── Image Artifacts (belong in /public/assets/) ─────────────
team1.jpg
team3.jpg
login_error.png
services_create_page.png

# ───────────── NEVER IGNORE (Protected Folders) ─────────────
# docs/, scripts/, tests/, postman/ are always tracked
!docs/
!**/docs/
!scripts/
!**/scripts/
!tests/
!**/tests/
!postman/
!**/postman/
