-- Data for faqs (11 rows)
INSERT INTO public."faqs" ("id", "category", "question", "answer", "order_index", "is_published", "created_at") VALUES
('d40e711c-fb91-4912-bdd0-1f435d1bfd70', 'Booking & Reservations', 'How do I make a booking on RoyalTravel?', 'Simply browse our curated collection of hotels, packages, and activities. Select your preferred dates and number of guests, click "Book Now," and follow the secure checkout process. You will receive an instant confirmation via email.', 10, True, '2026-05-03 06:13:33.996052+00'),
('7a2979b5-6246-42bc-b303-656769f06edc', 'Booking & Reservations', 'Can I book for a group?', 'Yes, RoyalTravel specializes in group bookings. For groups larger than 10 people, we recommend contacting our dedicated concierge team via WhatsApp or Email for personalized assistance and group rates.', 20, True, '2026-05-03 06:13:33.996052+00'),
('2eba4338-d3d3-43bc-98e9-83ce42ec0e38', 'Booking & Reservations', 'Is my booking confirmed immediately?', 'Most bookings for Local Deals and Day Packages are confirmed instantly. For some International Travel Packages, a short verification period may be required, and our team will update you within 24 hours.', 30, True, '2026-05-03 06:13:33.996052+00'),
('ff20fe1d-49c5-4206-81b1-d01ebb59b3b0', 'Payments & Refunds', 'What payment methods do you accept?', 'We accept all major credit/debit cards (Visa, Mastercard, Amex), Juice by MCB, and Bank Transfers. All transactions are secured with industry-standard encryption.', 40, True, '2026-05-03 06:13:33.996052+00'),
('ed035b26-9f53-4111-a979-bcf14da7e5f5', 'Payments & Refunds', 'Is it safe to pay online?', 'Absolutely. RoyalTravel uses a PCI-DSS compliant payment gateway, ensuring your financial information is never stored on our servers and is handled with maximum security.', 50, True, '2026-05-03 06:13:33.996052+00'),
('aaf722e6-baa8-4ed1-8694-1ed8f1b9d7c1', 'Payments & Refunds', 'What is your refund policy?', 'Refunds are subject to the specific cancellation policy of the service booked. Generally, if a refund is approved, it will be processed back to your original payment method within 5-10 business days.', 60, True, '2026-05-03 06:13:33.996052+00'),
('696cfc18-2ac6-4d99-ba15-c8bb31a71d4b', 'Check-in & Stay', 'What do I need to bring for hotel check-in?', 'You will need a valid National Identity Card or Passport and your RoyalTravel Booking Voucher (digital or printed).', 70, True, '2026-05-03 06:13:33.996052+00'),
('45fb7208-a071-4d46-8065-91b11fb59a05', 'Check-in & Stay', 'Can I request an early check-in or late check-out?', 'Early check-in and late check-out are subject to availability and the hotel''s policy. We recommend contacting the hotel directly or notifying our concierge team in advance.', 80, True, '2026-05-03 06:13:33.996052+00'),
('1d55ab8a-3b79-4b03-a083-eb77d8c2785f', 'Local Deals & Packages', 'Are these deals only for Mauritian Residents?', '"Local Deals" and "Day Packages" are often exclusive to Mauritian residents and permit holders. Please check the "Terms & Conditions" on the specific deal page for eligibility.', 90, True, '2026-05-03 06:13:33.996052+00'),
('aca2cfe9-e02d-4657-86b6-9848bb91d2c9', 'Local Deals & Packages', 'Do you offer corporate packages?', 'Yes, RoyalTravel offers bespoke solutions for corporate retreats, team-building events, and year-end parties. Contact our B2B team for a custom quote.', 100, True, '2026-05-03 06:13:33.996052+00'),
('b4c5ffd9-6690-44ac-87fc-a275ef4dbe90', 'Cancellations', 'How do I cancel my booking?', 'You can cancel your booking through your RoyalTravel Dashboard or by contacting our support team. Cancellation fees may apply depending on the time of cancellation and the service provider''s policy.', 110, True, '2026-05-03 06:13:33.996052+00')
ON CONFLICT DO NOTHING;

-- Data for content_blocks (11 rows)
INSERT INTO public."content_blocks" ("id", "page_slug", "section_key", "content", "updated_at") VALUES
('05e4d624-ff37-46a7-8d3b-c3b8b1fc898f', 'home', 'section_1_services', '{"label": "Exclusive Collections", "title": "Curated Travel <br/> Experiences", "description": "Discover our range of hand-picked travel categories, from luxury stays to adventurous tours across the world''s most beautiful destinations."}', '2026-04-27 16:51:37.98844+00'),
('d05deab1-f23c-410a-9d43-4084e7eec41d', 'home', 'section_2_advantage', '{"label": "Accredited Excellence", "stats": [{"label": "Years Experience", "value": "29+"}, {"label": "Happy Travelers", "value": "50k+"}], "title": "Decades of Travel <br/> Excellence", "description": "Since 1995, Royal Travel has been the beacon of premium travel services in Mauritius. Our commitment to excellence is backed by IATA accreditation and multiple global awards, ensuring that every journey you embark on is safe, seamless, and extraordinary."}', '2026-04-27 16:51:38.387805+00'),
('afddc33c-5329-4d2d-80da-89fa0227b6d8', 'home', 'section_3_deals', '{"label": "Exclusive Offers", "title": "Promotional Deals"}', '2026-04-27 16:51:38.706655+00'),
('8fbec57a-42d6-4c3c-86a8-3f6ecc678b44', 'home', 'section_4_partners', '{"label": "Our Strategic Partners"}', '2026-04-27 16:51:39.103811+00'),
('1d5d28f5-7d02-4f9f-ac00-029836302757', 'home', 'section_5_seo_content', '{"title": "Your Premier Boutique Travel Agency in Mauritius", "paragraph_1": "Experience the pinnacle of <strong>Luxury Mauritius Travel</strong> with Royal Travel. As the island''s leading boutique travel experts, we curate extraordinary journeys that go beyond standard hotel bookings. From the iconic shores of <strong>Le Morne</strong> to the hidden gems of the North Coast, our local concierge team ensures every detail is perfect.", "paragraph_2": "Whether you are seeking <strong>all-inclusive holiday packages</strong>, exclusive catamaran cruises, or bespoke world tours departing from Mauritius, we offer IATA-accredited expertise since 1995. Our commitment to excellence has made us the trusted choice for thousands of travelers seeking authentic island experiences.", "why_choose_list": ["Tailor-made itineraries crafted by local Mauritius destination experts.", "Exclusive access to boutique hotels and private villa collections.", "24/7 personalized concierge support throughout your stay."], "why_choose_label": "Why Choose Our Agency?"}', '2026-04-27 16:54:22.738359+00'),
('8fcec791-45f1-45e6-99bd-95101b7c6f70', 'home', 'section_6_news', '{"label": "Travel Insights", "title": "Latest from the <br/> <span class=''text-red-600 underline decoration-red-600/20 underline-offset-8''>Insider Lounge</span>"}', '2026-04-27 16:56:01.26193+00'),
('37d09166-ea01-4b8c-ac52-dee9a40209e0', 'about', 'section_1_hero', '{"badge": "Since 1995", "image": "https://images.unsplash.com/photo-1544644181-1484b3fdfc62?q=80&w=2070&auto=format&fit=crop", "title": "Defining the Art of <br/> Boutique Travel", "description": "We don''t just book trips; we craft legacies. Royal Travel is Mauritius''s premier gateway to extraordinary global experiences and authentic island discoveries."}', '2026-04-27 16:58:27.320372+00'),
('487300d3-e0f3-4f54-8036-98b83069c155', 'about', 'section_2_identity', '{"quote": "Our mission is to transform every journey into a masterpiece of memories, blending luxury with authentic local soul.", "title": "Mauritius''s Most <br/> Trusted Travel Experts", "description": "With over 29 years of excellence, Royal Travel stands as a pillar of trust in the Mauritian travel landscape. Our boutique approach ensures that every client receives personalized care, exclusive access, and the IATA-accredited expertise they deserve.", "stats_label": "Years of Excellence", "stats_value": "29+"}', '2026-04-27 16:58:27.624203+00'),
('da29094e-e348-4daa-af0e-fe9a95be5941', 'visa-services', 'cta', '{"title": "Need a Visa for your Next Trip?", "description": "<p>Whether&nbsp;it&#39;s&nbsp;for&nbsp;the&nbsp;USA,&nbsp;UK,&nbsp;Schengen&nbsp;Area,&nbsp;or&nbsp;Turkey,&nbsp;our&nbsp;specialized&nbsp;visa&nbsp;department&nbsp;is&nbsp;here&nbsp;to&nbsp;ensure&nbsp;a&nbsp;high-success&nbsp;application&nbsp;process.</p>", "primary_label": "Contact Visa Expert", "secondary_label": "View All Destinations"}', '2026-05-03 08:44:39.038608+00'),
('adf5ed33-1676-46d1-83f6-a5c711802320', 'visa-services', 'hero', '{"badge": "Expert Assistance", "image": "https://images.unsplash.com/photo-1544027993-37dbfe43562a?q=80&w=2070&auto=format&fit=crop", "title": "<p>Seamless&nbsp;</p><p>Visa&nbsp;Solutions.</p>", "subtitle": "Global Access Made Simple"}', '2026-05-03 08:44:44.14265+00'),
('0e70cce6-0b1c-47c2-bb80-76f0b7e9943a', 'visa-services', 'sidebar', '{"title": "Why Trust Royal Travel?", "features": [{"desc": "Decades of professional excellence in global travel documentation.", "icon": "ShieldCheck", "title": "IATA Certified"}, {"desc": "Dedicated experts for USA, Canada, and European visas.", "icon": "UserCheck", "title": "Specialized Desk"}, {"desc": "From the first inquiry to the final passport collection.", "icon": "RefreshCw", "title": "End-to-End Support"}], "notice_title": "Important Notice", "notice_content": "<p>While&nbsp;we&nbsp;provide&nbsp;expert&nbsp;guidance&nbsp;to&nbsp;maximize&nbsp;your&nbsp;success&nbsp;rate,&nbsp;visa&nbsp;issuance&nbsp;is&nbsp;the&nbsp;sole&nbsp;prerogative&nbsp;of&nbsp;the&nbsp;respective&nbsp;diplomatic&nbsp;missions.&nbsp;Fees&nbsp;are&nbsp;non-refundable&nbsp;regardless&nbsp;of&nbsp;the&nbsp;outcome.</p>", "disclaimer_label": "Visa Terms & Conditions"}', '2026-05-03 08:44:50.567671+00')
ON CONFLICT DO NOTHING;

