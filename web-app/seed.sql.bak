('8ef76b8a-9aff-461a-9aa5-879feb2a02b8', 'Aanari Hotel and Spa', '<p><span style="background-color: rgb(255, 255, 255); color: rgba(66, 66, 66, 0.8);">Rooted&nbsp;in&nbsp;Chinese,&nbsp;Indian&nbsp;and&nbsp;Creole&nbsp;traditions,&nbsp;Aanari&nbsp;is&nbsp;a&nbsp;reflection&nbsp;of&nbsp;Mauritius&nbsp;itself&nbsp;—&nbsp;a&nbsp;place&nbsp;where&nbsp;cultures&nbsp;blend&nbsp;seamlessly.&nbsp;Fifty&nbsp;rooms&nbsp;across&nbsp;two&nbsp;wings,&nbsp;steps&nbsp;from&nbsp;one&nbsp;of&nbsp;the&nbsp;island&#39;s&nbsp;finest&nbsp;beaches,&nbsp;with&nbsp;front-row&nbsp;seats&nbsp;to&nbsp;the&nbsp;west&nbsp;coast&nbsp;sunset.</span></p><p></p><p>CHECK&nbsp;IN&nbsp;:&nbsp;14&nbsp;HRS</p><p>CHECK&nbsp;OUT&nbsp;:&nbsp;11&nbsp;HRS</p>', 'Flic en Flac', 'West Coast', '4.5', 'services/1778227772690-oupewrj9qf.webp', '["Free Wifi", "Outdoor swimming pool", "Restaurant and Bar", "Fitness & Wellness", "spa", "beachfront"]', 'hotel', NULL, NULL, NULL, '2026-05-08 06:00:34.158+00', '2026-05-08 08:10:23.162+00', '[]', '[]', NULL, 'active', NULL, NULL, '["services/1778219922331-w328z00zcir.jpg", "services/1778219932615-9xti7ibp9xi.jpg", "services/1778219937898-lfl5x2jitkd.jpg", "services/1778219945505-abe9vi2ocgq.webp", "services/1778219952338-yfsnwd8m48l.jpg", "services/1778219965486-lteevniljss.jpg", "services/1778219975697-lpxjdxqktq.webp", "services/1778219989061-9nnuudh7lv.jpg", "services/1778219997705-bhqoy434c3k.jpg", "services/1778220012244-hym4gpx1u1n.webp"]', '', '', NULL, '[]', NULL, '[]', '[]', '[]', NULL, NULL, NULL, 'services/1778227805480-zjuhycjixm.jpg', False, 0, 'services/1778227812327-eueq4zna91c.jpg', False, 'Limited Time', True, False, 'Beachside Mauritian hotel with spa, sunsets, and multicultural dining experiences.', NULL, NULL, 12, '[]', NULL, '0', NULL),
('214f9389-6ad6-40b9-8f49-821c1a1a6bf7', 'Sunrise Attitude', '<p><strong>Sunrise&nbsp;Attitude&nbsp;(Mauritius)</strong>&nbsp;is&nbsp;a&nbsp;calm,&nbsp;adults-only&nbsp;hotel&nbsp;on&nbsp;the&nbsp;east&nbsp;coast&nbsp;at&nbsp;Belle&nbsp;Mare,&nbsp;known&nbsp;for&nbsp;its&nbsp;natural,&nbsp;eco-friendly&nbsp;design&nbsp;and&nbsp;relaxed&nbsp;atmosphere.&nbsp;It&nbsp;sits&nbsp;just&nbsp;across&nbsp;the&nbsp;road&nbsp;from&nbsp;a&nbsp;long&nbsp;white-sand&nbsp;beach&nbsp;with&nbsp;a&nbsp;turquoise&nbsp;lagoon,&nbsp;making&nbsp;it&nbsp;ideal&nbsp;for&nbsp;a&nbsp;peaceful&nbsp;seaside&nbsp;escape.</p><p></p><p>CHECK&nbsp;IN&nbsp;:&nbsp;14&nbsp;HRS</p><p>CHECK&nbsp;OUT&nbsp;:&nbsp;12&nbsp;HRS</p>', 'Belle Mare', 'East Coast', '4.5', 'services/1777705923929-bqb1qpce30f.jpg', '["Free Wifi", "swimming pool", "Foreign currency exchange", "laundry services", "spa", "parking", "Medical assistance", "restaurant & bar", "entertainment", "gym", "Land activities", "Water activities", "Yoga sessions"]', 'hotel', NULL, NULL, NULL, '2026-05-02 07:23:26.309+00', '2026-05-04 07:02:58.043+00', '[]', '[]', NULL, 'active', NULL, NULL, '["services/1777706051716-kbc4ljywb6.jpg", "services/1777706072481-csyqk64q3r.jpg", "services/1777706088931-tjidrd1nt8d.jpg", "services/1777706104805-fxjack9x3im.jpg", "services/1777706521098-br447o7vulj.webp", "services/1777706537316-s9agmcm3rm8.jpg", "services/1777706550991-f3dfveofjom.jpg", "services/1777706576458-744phc0j0be.jpg", "services/1777706585854-9d61by2nw3i.jpg"]', '', '', NULL, '[]', NULL, '[]', '[]', '[]', '<p>The&nbsp;applicable&nbsp;cancellation&nbsp;policy&nbsp;shall&nbsp;be&nbsp;as&nbsp;follows&nbsp;:</p><p>Cancellation&nbsp;date/period&nbsp;</p><p>Rate&nbsp;payable</p><p>Between&nbsp;D-7&nbsp;and&nbsp;D-4:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;50%&nbsp;of&nbsp;total&nbsp;rate&nbsp;payable</p><p>Between&nbsp;D-3&nbsp;and&nbsp;D-1:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;80%&nbsp;of&nbsp;total&nbsp;rate&nbsp;payable</p><p>Peak&nbsp;season&nbsp;between&nbsp;D-30&nbsp;and&nbsp;D-1:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;100%&nbsp;of&nbsp;total&nbsp;rate&nbsp;payable</p><p>No&nbsp;shows:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;100%&nbsp;of&nbsp;total&nbsp;rate&nbsp;payable</p><p>Unexpected&nbsp;departure:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;No&nbsp;refund.&nbsp;</p><p></p>', '<p>Rates&nbsp;are&nbsp;in&nbsp;MUR&nbsp;per&nbsp;room&nbsp;per&nbsp;night&nbsp;on&nbsp;&#39;Half&nbsp;Board&#39;&nbsp;basis&nbsp;[Breakfast&nbsp;&amp;&nbsp;Dinner]</p><p>Minimum&nbsp;of&nbsp;2-night&nbsp;stay&nbsp;for&nbsp;All&nbsp;inclusive&nbsp;basis&nbsp;and&nbsp;Half&nbsp;&amp;&nbsp;Full&nbsp;board&nbsp;basis&nbsp;for&nbsp;1&nbsp;night&nbsp;stay</p><p>&nbsp;</p>', NULL, 'services/1777706004232-yz4bpnmur4m.jpg', False, 0, 'services/1777705985703-luwyx4ymhha.jpg', False, 'Limited Time', True, False, 'We enjoy every moment, without rushing. Taking time to listen to the sea, watch the light change, feel the sand under our feet and the salty breeze in our hair.Sunrise Attitude is an adults-only hotel, calm and bright, focused on the essentials. Nothing more, nothing less.', NULL, NULL, 12, '[{"0": "A", "1": "l", "2": "l", "3": " ", "4": "I", "5": "n", "6": "c", "7": "l", "8": "u", "9": "s", "10": "i", "11": "v", "12": "e", "label": ""}, {"id": "1777877932663", "label": "Half Board"}, {"id": "1777879691975", "label": "All Inclusive"}]', NULL, '0', NULL),
('bb867a41-8510-4fd8-acf0-f3e49343e640', 'Laguna Hotel & Spa', '<p><span style="color: rgb(126, 126, 126); background-color: rgb(255, 255, 255);">Nestled&nbsp;on&nbsp;the&nbsp;unspoilt&nbsp;peninsula&nbsp;along&nbsp;the&nbsp;South&nbsp;East&nbsp;Coast&nbsp;of&nbsp;Mauritius,</span></p><p><span style="color: rgb(126, 126, 126); background-color: rgb(255, 255, 255);">the&nbsp;</span><strong style="color: rgb(126, 126, 126); background-color: rgb(255, 255, 255);">Laguna&nbsp;Beach&nbsp;Hotel&nbsp;&amp;&nbsp;Spa,</strong><span style="color: rgb(126, 126, 126); background-color: rgb(255, 255, 255);">&nbsp;a&nbsp;cosy&nbsp;and&nbsp;charming&nbsp;hotel&nbsp;invites&nbsp;you&nbsp;to&nbsp;discover&nbsp;the&nbsp;wildest&nbsp;landscapes&nbsp;of&nbsp;the&nbsp;Island&nbsp;and&nbsp;its&nbsp;preserved&nbsp;Flaura&nbsp;and&nbsp;Fauna.&nbsp;</span></p><p><span style="color: rgb(126, 126, 126); background-color: rgb(255, 255, 255);">From&nbsp;turquoise-blue&nbsp;water&nbsp;to&nbsp;impressive&nbsp;ravines,&nbsp;spectacular&nbsp;waterfalls,&nbsp;mountainous&nbsp;terrains&nbsp;offering&nbsp;magnificent&nbsp;panorama&nbsp;and&nbsp;historical&nbsp;sites,</span></p><p><span style="color: rgb(126, 126, 126); background-color: rgb(255, 255, 255);">the&nbsp;region’s&nbsp;simplicity&nbsp;and&nbsp;tranquil&nbsp;atmosphere&nbsp;make&nbsp;up&nbsp;all&nbsp;its&nbsp;charm.</span></p><p></p><p>Check&nbsp;in&nbsp;:&nbsp;14&nbsp;hrs</p><p>Check&nbsp;out&nbsp;:&nbsp;11&nbsp;hrs</p>', ' Camp des Pecheurs,Grand River South East', 'East Coast', '4.5', 'services/1777548302443-4gabojctdo2.jpg', '[]', 'hotel', NULL, NULL, NULL, '2026-04-30 11:27:41.076+00', '2026-05-02 07:40:38.819+00', '[]', '[]', NULL, 'active', NULL, NULL, '["services/1777548354621-3ni2b469o0r.jpg", "services/1777548369791-xejtm5ncce.jpg", "services/1777548379985-kv8lkmoz9vc.jpg", "services/1777548391844-ne9ws0mtzdf.jpg", "services/1777548413698-6s8kftkkclx.jpg", "services/1777548430849-x50255uhqy.jpg"]', '', '', NULL, '[]', NULL, '[]', '["International breakfast buffet: 07:30 to 10:00", "Lunch Buffet (12:00 to 14:30) at main the Restaurant only.", "Theme dinner buffet: 19:30 to 22:00", "Afternoon Tea/Coffee Cake or Pancake: 16:00 to 17:00", "Drink included: Tea/Coffee, juice, water, beer, pre-selection of cocktails and locally bottled spirits and served at Bar from 10:30 to 22:30"]', '[]', '<p>•&nbsp;Free&nbsp;Cancellation&nbsp;7&nbsp;days&nbsp;prior&nbsp;to&nbsp;arrival&nbsp;date</p><p>•&nbsp;D-6&nbsp;/&nbsp;D-1&nbsp;&amp;&nbsp;NO&nbsp;Show&nbsp;–&nbsp;Full&nbsp;Cancellation&nbsp;fee&nbsp;shall&nbsp;be&nbsp;applicable.</p>', '<ul><li>Applicable&nbsp;to&nbsp;Mauritian&nbsp;citizens&nbsp;only</li></ul>', NULL, 'services/1777548283303-tqjcbhs497.jpg', False, 0, 'services/1777548570718-znvixj8tr7n.jpg', False, 'Limited Time', True, False, 'Facing the largest lagoon of Mauritius and the Grand Port mountain range on the other, the hotel is a gem in its kind: a postcard beauty with a real soul.', NULL, NULL, 12, '[{"id": "1777707186057", "label": "All Inclusive"}, "All Inclusive"]', NULL, '0', NULL),
('7cdae51a-8ee8-45c8-9462-a2aba76b7964', 'Tropical Attitude', '<p><span style="color: rgb(16, 76, 82); background-color: rgb(248, 253, 254);">At&nbsp;Tropical&nbsp;Attitude,&nbsp;time&nbsp;becomes&nbsp;wonderfully&nbsp;irrelevant&nbsp;–&nbsp;and&nbsp;that’s&nbsp;exactly&nbsp;its&nbsp;charm.&nbsp;Every&nbsp;room&nbsp;at&nbsp;this&nbsp;intimate&nbsp;boutique&nbsp;hotel&nbsp;opens&nbsp;up&nbsp;to&nbsp;the&nbsp;sea.&nbsp;Your&nbsp;days&nbsp;here&nbsp;follow&nbsp;the&nbsp;tide,&nbsp;the&nbsp;moving&nbsp;shade&nbsp;of&nbsp;the&nbsp;coconut&nbsp;palms,&nbsp;and&nbsp;the&nbsp;daily&nbsp;routines&nbsp;of&nbsp;local&nbsp;fishermen.</span></p><p></p><p><span style="color: rgb(16, 76, 82); background-color: rgb(248, 253, 254);">So&nbsp;hit&nbsp;‘pause’.&nbsp;Breathe&nbsp;out.&nbsp;And&nbsp;slip&nbsp;into&nbsp;the&nbsp;laid-back&nbsp;rhythm&nbsp;of&nbsp;the&nbsp;East&nbsp;Coast.</span></p><p><span style="color: rgb(16, 76, 82); background-color: rgb(248, 253, 254);">After&nbsp;all,&nbsp;isn’t&nbsp;that&nbsp;what&nbsp;holidays&nbsp;are&nbsp;for?</span></p><p></p><p>CHECK&nbsp;IN&nbsp;:&nbsp;14&nbsp;HRS</p><p>CHECK&nbsp;OUT&nbsp;:&nbsp;12&nbsp;HRS</p>', 'Trou d''eau Douces', 'East Coast', '4.5', 'services/1777707575883-pcbzeqrgch.jpg', '["Free wifi ", "laundry services", "swimming pool", "bar & restaurant", "Foreign currency exchange", "Lounge", "parking", "land activities", "water activities", "Open Air Cinema", "Evening Entertainment", "spa", "outdoor gym"]', 'hotel', NULL, NULL, NULL, '2026-05-02 07:33:34.669+00', '2026-05-04 10:07:41.499+00', '[]', '[]', NULL, 'active', NULL, NULL, '["services/1777708193771-w3tl00ew4vs.webp", "services/1777708209218-j6rp8imogj.jpg", "services/1777708216994-pdoc5q4735q.jpg", "services/1777708232868-v4hmky3ywyl.webp", "services/1777708252998-n7icstes56b.jpg", "services/1777708261262-8bnma56uxqr.jpg", "services/1777708292820-0xqperfazoqb.webp", "services/1777708307532-a997gv1qk4t.jpg", "services/1777708325909-5ldnsmphkpi.webp", "services/1777708342117-ysp0xz25sbs.jpg"]', '', '', NULL, '[]', NULL, '[]', '[]', '[]', '<p>Cancellation&nbsp;Policy</p><p>The&nbsp;applicable&nbsp;cancellation&nbsp;policy&nbsp;shall&nbsp;be&nbsp;as&nbsp;follows&nbsp;:</p><p>Cancellation&nbsp;date/period&nbsp;</p><p>Rate&nbsp;payable</p><p>Between&nbsp;D-7&nbsp;and&nbsp;D-4:&nbsp;50%&nbsp;of&nbsp;total&nbsp;rate&nbsp;payable</p><p>Between&nbsp;D-3&nbsp;and&nbsp;D-1:&nbsp;80%&nbsp;of&nbsp;total&nbsp;rate&nbsp;payable</p><p>Peak&nbsp;season&nbsp;between&nbsp;D-30&nbsp;and&nbsp;D-1:&nbsp;100%&nbsp;of&nbsp;total&nbsp;rate&nbsp;payable</p><p>No&nbsp;shows:&nbsp;100%&nbsp;of&nbsp;total&nbsp;rate&nbsp;payable</p><p>Unexpected&nbsp;departure:&nbsp;No&nbsp;refund.&nbsp;</p><p></p>', '<p>Rates&nbsp;are&nbsp;in&nbsp;MUR&nbsp;per&nbsp;room&nbsp;per&nbsp;night&nbsp;on&nbsp;&#39;Half&nbsp;Board&#39;&nbsp;basis&nbsp;[&nbsp;Breakfast&nbsp;&amp;&nbsp;Dinner&nbsp;].</p><p></p><p>Minimum&nbsp;of&nbsp;2-night&nbsp;stay&nbsp;for&nbsp;All&nbsp;inclusive&nbsp;basis&nbsp;and&nbsp;Half&nbsp;&amp;&nbsp;Full&nbsp;board&nbsp;basis&nbsp;for&nbsp;1&nbsp;night&nbsp;stay</p>', NULL, 'services/1777708154193-e3qba79p87s.jpg', False, 0, 'services/1777708168215-rnxxnie0oz.jpg', False, 'Limited Time', True, False, 'Tropical Attitude sits just outside this small fishing village on the East Coast – an easy-going place of colourful boats and lagoon life.', NULL, NULL, 12, '[{"id": "1777709734385", "label": "Half Board"}, {"id": "1777709744265", "label": "All Inclusive"}]', NULL, '0', NULL),
('420055fc-32d3-4b87-8a61-e4d0e0dddd2a', 'Le Jadis Beach Resort & Wellness Mauritius', '<p><span style="color: rgb(26, 26, 26);">Set&nbsp;on&nbsp;the&nbsp;picturesque&nbsp;North&nbsp;West&nbsp;coast&nbsp;of&nbsp;Mauritius,&nbsp;Le&nbsp;Jadis&nbsp;Beach&nbsp;Resort&nbsp;&amp;&nbsp;Wellness&nbsp;-&nbsp;Managed&nbsp;by&nbsp;Banyan&nbsp;Tree&nbsp;Hotels&nbsp;&amp;&nbsp;Resorts,&nbsp;enjoys&nbsp;a&nbsp;prime&nbsp;location&nbsp;in&nbsp;Turtle&nbsp;Bay,&nbsp;offering&nbsp;breathtaking&nbsp;daily&nbsp;sunsets&nbsp;over&nbsp;a&nbsp;serene,&nbsp;sun-kissed&nbsp;beach.&nbsp;This&nbsp;five-star&nbsp;boutique&nbsp;resort&nbsp;features&nbsp;an&nbsp;Imperial&nbsp;Beach&nbsp;Villa&nbsp;and&nbsp;54&nbsp;spacious&nbsp;Luxury&nbsp;Suites,&nbsp;most&nbsp;with&nbsp;private&nbsp;heated&nbsp;infinity&nbsp;pools&nbsp;and&nbsp;some&nbsp;with&nbsp;additional&nbsp;standout&nbsp;features&nbsp;such&nbsp;as&nbsp;peninsular&nbsp;timber&nbsp;verandas,&nbsp;jet&nbsp;pools,&nbsp;hammams,&nbsp;and&nbsp;impressive&nbsp;handcrafted&nbsp;stone&nbsp;tubs&nbsp;with&nbsp;ocean&nbsp;view.</span></p><p></p><p>CHECK&nbsp;IN&nbsp;:&nbsp;14&nbsp;HRS</p><p>CHECK&nbsp;OUT&nbsp;:&nbsp;11&nbsp;HRS</p>', 'Balaclava', 'North Coast', '4.5', 'services/1778136284491-w2twhkssfcm.jpg', '["Wifi", "Restaurants", "Spa & Wellness", "Gym", "Swimming Pool", "Land Activities", "Water Activities", "live music evening", "yoga and meditation", "kids corner"]', 'hotel', NULL, NULL, NULL, '2026-05-06 16:23:26.205+00', '2026-05-07 06:57:57.274+00', '[]', '[]', NULL, 'active', NULL, NULL, '["services/1778136589560-f01nzdvrf8.jpg", "services/1778136605711-9jvlnh9j9ai.jpg", "services/1778136619534-9biwkbs20de.jpg", "services/1778136646109-qcvc3x4ha9k.jpg", "services/1778136662882-ioswink40v.jpg", "services/1778136674792-mwuk6brgbek.jpg", "services/1778136689066-cmqtgkvkbq7.jpg", "services/1778136717071-ou6wlltq3a.jpg", "services/1778136735776-m5ulpvzvgj8.jpg", "services/1778136745656-qjehef6i4qq.jpg"]', '', '', NULL, '[]', NULL, '[]', '["Breakfast:\tBreakfast\tBuffet\tat\tSylea\trestaurant", "Dinner:\t\u00c0\tla\tCarte\tor\tChef\u2019s\tSelection\tat\tSylea\t or\tOryza\tor\tCruso\ton\tthe\tBeach\trestaurant\t(1\t starter,\t1\tmain\tcourse,\t1\tdessert;\tbeverages\t excluded;\tsupplements\tapply\ton\tspecialty\titems)", "Complimentary\t30-min\tHydrotherapy\tsession\t at\tour\taward-winning\tSpa\t&\tWellness", "Complimentary\taccess\tto\tnon-motorized\twater\t sports\tand\tboat\tactivities", "Complimentary\tdaily\twellness\tactivities\t \t(except\tSundays):\thatha\tyoga,\tpaddle\tyoga,\t sound\thealing\t&\tmeditation"]', '[]', '<p>-&nbsp;Non-refundable:&nbsp;full&nbsp;reservation&nbsp;amount&nbsp;will&nbsp;be&nbsp;charged</p><p>-&nbsp;No-show:&nbsp;100%&nbsp;fee&nbsp;applied</p>', '<p>-&nbsp;Minimum&nbsp;stay:&nbsp;2&nbsp;nights&nbsp;on&nbsp;weekends&nbsp;(between&nbsp;Friday&nbsp;and&nbsp;Sunday)</p><p>-&nbsp;The&nbsp;offer&nbsp;is&nbsp;not&nbsp;combinable&nbsp;with&nbsp;any&nbsp;other&nbsp;offers&nbsp;or&nbsp;promotions</p><p>-&nbsp;Applicable&nbsp;only&nbsp;for&nbsp;locals&nbsp;and&nbsp;residents&nbsp;-&nbsp;Extras&nbsp;must&nbsp;be&nbsp;paid&nbsp;directly&nbsp;at&nbsp;the&nbsp;resort&nbsp;before&nbsp;departure</p><p>-&nbsp;Booking&nbsp;requests&nbsp;subject&nbsp;to&nbsp;hotel&nbsp;confirmation</p><p>-&nbsp;Rates&nbsp;quoted&nbsp;in&nbsp;Mauritian&nbsp;Rupees&nbsp;(MUR),&nbsp;per&nbsp;suite,&nbsp;inclusive&nbsp;of&nbsp;15%&nbsp;VAT</p><p>-&nbsp;100%&nbsp;advance&nbsp;payment&nbsp;required&nbsp;upon&nbsp;booking&nbsp;confirmation</p>', NULL, 'services/1778136323807-kkd3nh7nj3.jpg', False, 0, 'services/1778136346629-4rt284yoiyv.jpg', False, 'Limited Time', True, False, '5 Star Luxury Beach Hotel situated at Balaclava', NULL, NULL, 12, '[{"id": "1778137818733", "label": "Half Board"}, {"id": "1778137829853", "label": "Full Board"}, {"id": "1778137840485", "label": "All Inclusive"}]', NULL, '0', NULL),
('0f21fcd0-dc44-471d-9247-c36880c12933', 'The Ravenala Attitude', '<p>It’s&nbsp;an&nbsp;exotic&nbsp;journey&nbsp;in&nbsp;the&nbsp;heart&nbsp;of&nbsp;Mauritius.&nbsp;Nestled&nbsp;between&nbsp;the&nbsp;sea,&nbsp;river,&nbsp;and&nbsp;mountains,&nbsp;The&nbsp;Ravenala&nbsp;Attitude&nbsp;4*&nbsp;is&nbsp;a&nbsp;true&nbsp;open-air&nbsp;tropical&nbsp;garden.&nbsp;The&nbsp;setting&nbsp;is&nbsp;established&nbsp;and&nbsp;the&nbsp;atmosphere&nbsp;follows:&nbsp;life&nbsp;flows&nbsp;seamlessly&nbsp;between&nbsp;indoors&nbsp;and&nbsp;outdoors,&nbsp;whether&nbsp;you’re&nbsp;there&nbsp;as&nbsp;a&nbsp;couple,&nbsp;with&nbsp;family,&nbsp;or&nbsp;with&nbsp;friends—and&nbsp;you&nbsp;simply&nbsp;feel&nbsp;good…&nbsp;naturally.</p><p></p><p>CHECK&nbsp;IN&nbsp;:&nbsp;14&nbsp;HRS&nbsp;</p><p>CHECK&nbsp;OUT&nbsp;:&nbsp;12&nbsp;HRS</p>', 'Balaclava', 'Mauritius', '4.5', 'services/1777701345363-ge6iarxcd08.jpg', '["Free wifi", "Parking", "swimming pool", "Currency exchange at the reception", "Beach Towel", "Restaurant & Bar", "kids club", "spa", "local shop", "entertainment", "gym", "activities"]', 'hotel', NULL, NULL, NULL, '2026-05-02 05:49:41.446+00', '2026-05-04 10:01:21.172+00', '[]', '[]', NULL, 'active', NULL, NULL, '["services/1777701394989-71h2lktfx0p.webp", "services/1777701417581-vmx64511b4.jpg", "services/1777701438570-sii978r8rn.jpg", "services/1777701447937-519doxsvxgm.jpg", "services/1777701456482-jgc6rnkpqkm.jpg", "services/1777701475733-stpekni018.jpg", "services/1777701484251-g5d6v1pvuh5.jpg"]', '', '', NULL, '[]', NULL, '[]', '[]', '[]', '<p>Cancellation&nbsp;Policy</p><p>The&nbsp;applicable&nbsp;cancellation&nbsp;policy&nbsp;shall&nbsp;be&nbsp;as&nbsp;follows&nbsp;:</p><p>Cancellation&nbsp;date/period&nbsp;</p><p>Rate&nbsp;payable</p><p>Between&nbsp;D-7&nbsp;and&nbsp;D-4:&nbsp;50%&nbsp;of&nbsp;total&nbsp;rate&nbsp;payable</p><p>Between&nbsp;D-3&nbsp;and&nbsp;D-1:&nbsp;80%&nbsp;of&nbsp;total&nbsp;rate&nbsp;payable</p><p>Peak&nbsp;season&nbsp;between&nbsp;D-30&nbsp;and&nbsp;D-1:&nbsp;100%&nbsp;of&nbsp;total&nbsp;rate&nbsp;payable</p><p>No&nbsp;shows:&nbsp;100%&nbsp;of&nbsp;total&nbsp;rate&nbsp;payable</p><p>Unexpected&nbsp;departure:&nbsp;No&nbsp;refund.&nbsp;</p>', '<p>&nbsp;</p><p>Rates&nbsp;are&nbsp;in&nbsp;MUR&nbsp;per&nbsp;room&nbsp;per&nbsp;night&nbsp;on&nbsp;&#39;Half&nbsp;Board&#39;&nbsp;basis&nbsp;[&nbsp;Breakfast&nbsp;&amp;&nbsp;Dinner&nbsp;].</p><p></p><p>Children&nbsp;who&nbsp;are&nbsp;less&nbsp;than&nbsp;3&nbsp;years&nbsp;old&nbsp;are&nbsp;FOC&nbsp;on&nbsp;parents&nbsp;meal&nbsp;plan&nbsp;booked.</p><p></p><p>Single&nbsp;Parent&nbsp;Policy&nbsp;:&nbsp;1&nbsp;Adult&nbsp;+&nbsp;1&nbsp;Child&nbsp;/&nbsp;Teen&nbsp;=&nbsp;Pays&nbsp;2&nbsp;*&nbsp;1/2&nbsp;Double.</p><p></p><p>A&nbsp;minimum&nbsp;of&nbsp;2&nbsp;children/teens&nbsp;is&nbsp;required&nbsp;per&nbsp;Suite&nbsp;for&nbsp;children/teens&nbsp;in&nbsp;their&nbsp;own&nbsp;Suite.</p><p></p><p>Minimum&nbsp;of&nbsp;2-night&nbsp;stay&nbsp;for&nbsp;All&nbsp;inclusive&nbsp;basis&nbsp;and&nbsp;Half&nbsp;&amp;&nbsp;Full&nbsp;board&nbsp;basis&nbsp;for&nbsp;1&nbsp;night&nbsp;stay.</p>', NULL, 'services/1777701360093-9rs2tvgzvsn.jpg', False, 0, 'services/1777701373024-xg8njmezay.webp', False, 'Limited Time', True, False, 'The hotel is located right next to the village of Balaclava and its peaceful beach. The water is clear, the sand is warm, and the atmosphere is serene. Grand Baie is just 15 minutes away for strolling through shops and enjoying the nightlife, while Port Louis is 20 minutes away, known for its vibrant and colorful market.', NULL, NULL, 12, '[{"id": "1777959156787", "label": "Half Board"}, {"id": "1777959165269", "label": "All Inclusive"}]', NULL, '0', NULL),
('dda7ef2a-b837-4056-8977-77668f2a7c74', 'Wonders Beach Boutique Hotel', '<p><span style="background-color: rgb(255, 255, 255); color: rgb(0, 0, 0);">Wonders&nbsp;Beach&nbsp;is&nbsp;a&nbsp;newly&nbsp;built,&nbsp;elegant,&nbsp;and&nbsp;innovative&nbsp;resort.</span></p><p><span style="background-color: rgb(255, 255, 255); color: rgb(0, 0, 0);">It&nbsp;has&nbsp;been&nbsp;designed&nbsp;for&nbsp;its&nbsp;guests&nbsp;to&nbsp;fully&nbsp;experience&nbsp;and&nbsp;enjoy&nbsp;the&nbsp;state-of-the-art&nbsp;service,&nbsp;sophisticated&nbsp;amenities&nbsp;and&nbsp;a&nbsp;variety&nbsp;of&nbsp;activities.</span></p><p><span style="background-color: rgb(255, 255, 255); color: rgb(0, 0, 0);">The&nbsp;large&nbsp;variety&nbsp;of&nbsp;first-class&nbsp;rooms&nbsp;have&nbsp;an&nbsp;unbeatable&nbsp;view&nbsp;on&nbsp;the&nbsp;turquoise&nbsp;lagoon&nbsp;of&nbsp;&nbsp;Mon&nbsp;Choisy&nbsp;with&nbsp;dedicated&nbsp;service&nbsp;and&nbsp;genuine&nbsp;hospitality.</span></p><p>Our&nbsp;mission&nbsp;is&nbsp;to&nbsp;make&nbsp;your&nbsp;stay&nbsp;in&nbsp;Mauritius&nbsp;simply&nbsp;memorable,&nbsp;unforgettable.</p><p></p><p>CHECK&nbsp;IN&nbsp;:&nbsp;14HRS</p><p>CHECK&nbsp;OUT&nbsp;:&nbsp;11HRS</p>', 'Mont Choisy', 'North Coast', '4.5', 'services/1778229280786-v9w1n78h8u.jpg', '["free wifi", "Swimming Pool", "Private beach", "24-hour services", "24-hour reception", "outdoor swimming pool", "Spa & Wellness", "Gym", "Restaurant & Bar"]', 'hotel', NULL, NULL, NULL, '2026-05-08 08:23:01.286+00', '2026-05-08 08:37:13.921+00', '[]', '[]', NULL, 'active', NULL, NULL, '["services/1778228654103-tdjkyc7dbl.jpg", "services/1778228668180-8kahs77ankh.jpg", "services/1778228678259-boeb1gb7nl9.jpg", "services/1778228691066-4cwoxcvupii.jpg", "services/1778228699238-r98simgp2im.jpg", "services/1778228706609-9yuuvobps0b.jpg"]', '', '', NULL, '[]', NULL, '[]', '[]', '[]', NULL, NULL, NULL, 'services/1778229397176-xai9mqcl5a.jpg', False, 0, 'services/1778228634152-88mw8s8a2r2.jpg', False, 'Limited Time', True, False, 'Wonders Beach is a newly built, elegant, and innovative resort.', NULL, NULL, 12, '[]', NULL, '0', NULL),
('a79dae6f-9596-42fd-94a1-54c1e6e74fdf', 'Dubai & Malaysia Group Tour ', '<ul><li>Air&nbsp;Ticket&nbsp;With&nbsp;Emirates&nbsp;</li><li>4&nbsp;Nights&nbsp;At&nbsp;Hyatt&nbsp;Place&nbsp;Al&nbsp;Wasl,&nbsp;4★&nbsp;Or&nbsp;Similar&nbsp;</li><li>7&nbsp;Nights&nbsp;Stay&nbsp;At&nbsp;Royal&nbsp;Hotel&nbsp;,&nbsp;4★&nbsp;Or&nbsp;Similar&nbsp;</li><li>Daily&nbsp;Breakfast&nbsp;</li><li>Return&nbsp;Airport&nbsp;Transfer&nbsp;</li><li>Desert&nbsp;Safari&nbsp;With&nbsp;Bbq&nbsp;Dinner&nbsp;Including&nbsp;Return&nbsp;Transfer&nbsp;</li><li>Half&nbsp;Day&nbsp;City&nbsp;Tour&nbsp;Including&nbsp;Return&nbsp;Transfer&nbsp;</li><li>Half&nbsp;Day&nbsp;Batu&nbsp;Caves&nbsp;And&nbsp;City&nbsp;Tour&nbsp;Including&nbsp;Return&nbsp;Transfer&nbsp;</li><li>Full&nbsp;Day&nbsp;Genting&nbsp;Highland&nbsp;Including&nbsp;Cable&nbsp;Car&nbsp;Ticket&nbsp;And&nbsp;Return&nbsp;Transfer&nbsp;</li></ul><pre data-language="plain">
Discover two iconic destinations in one incredible journey! 
From the futuristic skyline and luxury experiences of Dubai to the vibrant culture, breathtaking attractions, and tropical charm of Malaysia — this group tour is designed for travellers who want excitement, comfort, and unforgettable memories all in one trip.
Join us for an amazing holiday filled with adventure, shopping, sightseeing, and moments to remember forever. 
</pre>', NULL, 'Dubai & Malaysia', '4.5', 'services/1778226485916-vpqyf5tbv1i.jpg', '[]', 'tour', NULL, NULL, NULL, '2026-05-08 07:48:42.562+00', '2026-05-08 09:53:53.985+00', '[]', '[{"day": "Day 1", "time": "", "title": " Arrive Airport Dubai, Meet & Greet by our representative ", "image_url": "", "description": "<p></p>"}, {"day": "Day 2", "time": "", "title": "Morning Free + At around 14h30 Desert Safari with BBQ dinner including return transfer", "image_url": "", "description": ""}, {"day": "Day 3", "time": "", "title": "Free for Leisure ", "image_url": "", "description": ""}, {"day": "Day 4", "time": "", "title": "Half day city tour including return transfer and afternoon free for leisure ", "image_url": "", "description": ""}, {"day": "Day 5", "time": "", "title": "Dubai \u2013 Malaysia , Arrive Malaysia Airport , Meet & Greet by our representative ", "image_url": "", "description": ""}, {"day": "Day 6", "time": "", "title": "Free for leisure ", "image_url": "", "description": ""}, {"day": "Day 7", "time": "", "title": "Half day city tour and afternoon free for leisure", "image_url": "", "description": ""}, {"day": "Day 8", "time": "", "title": "Half day Batu Caves and afternoon free for leisure", "image_url": "", "description": ""}, {"day": "Day 9", "time": "", "title": "Free for leisure ", "image_url": "", "description": ""}, {"day": "Day 10", "time": "", "title": "Full day Genting Highlands ", "image_url": "", "description": ""}, {"day": "Day 11", "time": "", "title": "Free for leisure ", "image_url": "", "description": ""}, {"day": "Day 12", "time": "", "title": "Departure from Malaysia \u2013 Mauritius ", "image_url": "", "description": ""}]', NULL, 'active', NULL, NULL, '[]', '', '', NULL, '[]', NULL, '["Travelling date: 17 \u2013 28 July 2026", "Cost of package per person sharing double room"]', '[]', '[]', NULL, '<p><span style="color: rgb(34, 34, 34); background-color: rgb(255, 255, 255);">*&nbsp;Conditions&nbsp;apply,&nbsp;subject&nbsp;to&nbsp;availability</span></p>', NULL, 'services/1778233368011-uqsg0r92kib.jpg', False, 0, 'services/1778233653913-0r3uhln0khv.webp', False, 'Limited Time', True, False, ' Double the adventure, double the memories — Explore Dubai & Malaysia together on one unforgettable group tour!
', NULL, NULL, 12, '[]', NULL, '0', NULL),
('6faa2def-754f-4b0d-aaaf-f909cef77a05', 'Zilwa Attitude', '<p><span style="background-color: rgb(240, 235, 229); color: rgb(78, 89, 101);">Need&nbsp;to&nbsp;let&nbsp;off&nbsp;steam&nbsp;or&nbsp;recharge&nbsp;your&nbsp;batteries?&nbsp;Want&nbsp;to&nbsp;practice&nbsp;an&nbsp;activity&nbsp;on&nbsp;dry&nbsp;land&nbsp;or&nbsp;on&nbsp;the&nbsp;water?&nbsp;At&nbsp;4*&nbsp;Zilwa&nbsp;Attitude&nbsp;hotel,&nbsp;give&nbsp;free&nbsp;rein&nbsp;to&nbsp;your&nbsp;desires&nbsp;and&nbsp;your&nbsp;curiosity.&nbsp;You&nbsp;can&nbsp;try&nbsp;stand-up&nbsp;paddleboarding,&nbsp;water&nbsp;aerobics,&nbsp;tennis&nbsp;or&nbsp;even&nbsp;tai&nbsp;chi.&nbsp;There&nbsp;are&nbsp;a&nbsp;wide&nbsp;range&nbsp;of&nbsp;activities&nbsp;available&nbsp;for&nbsp;your&nbsp;relaxation&nbsp;and&nbsp;pleasure,&nbsp;with&nbsp;the&nbsp;added&nbsp;bonus&nbsp;of&nbsp;exploring&nbsp;the&nbsp;superb&nbsp;lagoon!</span></p><p></p><p>CHECK&nbsp;IN&nbsp;:&nbsp;14&nbsp;HRS</p><p>CHECK&nbsp;OUT&nbsp;:&nbsp;12&nbsp;HRS</p>', 'Calodyne', 'Mauritius', '4.5', 'services/1777702743614-letpgw4nwu.jpg', '["Free wifi", "laundry services", "Beach towels", "Baby changing room", "Foreign currency exchange service", "Local shop", "Computer with Internet access", "spa", "restaurant", "swimming pool", "Water activities", "gym", "entertainment", "board games", "Land Activities", "kids activities"]', 'hotel', NULL, NULL, NULL, '2026-05-02 06:27:18.872+00', '2026-05-04 10:03:44.002+00', '[]', '[]', NULL, 'active', NULL, NULL, '["services/1777702779794-cfesxst5v6.jpg", "services/1777702786264-pc3guj0r3i.jpg", "services/1777702889430-rj8h6ot5tak.jpg", "services/1777702896481-ybhj69oefv.jpg", "services/1777702904290-px0cix31gj.jpg", "services/1777703046311-66e1pdt4508.jpg", "services/1777703149335-bpr39onsts.jpg", "services/1777703158030-0wv9ywkaxk1a.jpg", "services/1777703174337-8w1e3er2wbl.jpg"]', '', '', NULL, '[]', NULL, '[]', '[]', '[]', '<p>Cancellation&nbsp;Policy</p><p>The&nbsp;applicable&nbsp;cancellation&nbsp;policy&nbsp;shall&nbsp;be&nbsp;as&nbsp;follows&nbsp;:</p><p>Cancellation&nbsp;date/period&nbsp;</p><p>Rate&nbsp;payable</p><p>Between&nbsp;D-7&nbsp;and&nbsp;D-4:&nbsp;50%&nbsp;of&nbsp;total&nbsp;rate&nbsp;payable</p><p>Between&nbsp;D-3&nbsp;and&nbsp;D-1:&nbsp;80%&nbsp;of&nbsp;total&nbsp;rate&nbsp;payable</p><p>Peak&nbsp;season&nbsp;between&nbsp;D-30&nbsp;and&nbsp;D-1:&nbsp;100%&nbsp;of&nbsp;total&nbsp;rate&nbsp;payable</p><p>No&nbsp;shows:&nbsp;100%&nbsp;of&nbsp;total&nbsp;rate&nbsp;payable</p><p>Unexpected&nbsp;departure:&nbsp;No&nbsp;refund.&nbsp;</p>', '<p>&nbsp;</p><p>Rates&nbsp;are&nbsp;in&nbsp;MUR&nbsp;per&nbsp;room&nbsp;per&nbsp;night&nbsp;on&nbsp;&#39;Half&nbsp;Board&#39;&nbsp;basis&nbsp;[&nbsp;Breakfast&nbsp;&amp;&nbsp;Dinner&nbsp;].</p><p></p><p>Children&nbsp;who&nbsp;are&nbsp;less&nbsp;than&nbsp;3&nbsp;years&nbsp;old&nbsp;are&nbsp;FOC&nbsp;on&nbsp;parents&nbsp;meal&nbsp;plan&nbsp;booked.</p><p></p><p>A&nbsp;minimum&nbsp;of&nbsp;2&nbsp;children/teens&nbsp;is&nbsp;required&nbsp;per&nbsp;room&nbsp;for&nbsp;children/teens&nbsp;in&nbsp;their&nbsp;own&nbsp;room.</p><p></p><p>Single&nbsp;Parent&nbsp;Policy&nbsp;:&nbsp;1&nbsp;Adult&nbsp;+&nbsp;1&nbsp;Child&nbsp;/&nbsp;Teen&nbsp;=&nbsp;Pays&nbsp;2&nbsp;*&nbsp;1/2&nbsp;Double.</p><p>&nbsp;</p><p>Minimum&nbsp;of&nbsp;2-night&nbsp;stay&nbsp;for&nbsp;All&nbsp;inclusive&nbsp;basis&nbsp;and&nbsp;Half&nbsp;&amp;&nbsp;Full&nbsp;board&nbsp;basis&nbsp;for&nbsp;1&nbsp;night&nbsp;stay</p><p>&nbsp;</p>', NULL, 'services/1777702732354-ku5rihge00i.jpg', False, 0, 'services/1777702763969-pt1h3a3ybot.webp', False, 'Limited Time', True, False, 'Zilwa Attitude is a relaxed beachfront hotel in Mauritius with a local island vibe, offering simple comfort, good food, and beautiful lagoon views.', NULL, NULL, 12, '[{"id": "1777895852502", "label": ""}, {"id": "1777895854877", "label": "Half Board"}, {"id": "1777895866328", "label": "All Inclusive"}]', NULL, '0', NULL),
('b081c15c-9b79-4bbb-9e7c-debd26ee13ba', 'Malaysia Package ', '<ul><li>6&nbsp;Nights&nbsp;at&nbsp;Hotel&nbsp;Royal&nbsp;(or&nbsp;Similar)</li><li>Daily&nbsp;Breakfast&nbsp;Included</li><li>Airport&nbsp;Transfers&nbsp;Included</li><li>Half-Day&nbsp;City&nbsp;Tour&nbsp;</li><li>Half-Day&nbsp;Country&nbsp;Tour&nbsp;to&nbsp;Batu&nbsp;Caves</li><li>Full-Day&nbsp;Genting&nbsp;Highlands&nbsp;Tour&nbsp;(Inclusive&nbsp;of&nbsp;Cable&nbsp;Car&nbsp;Tickets)</li><li>All&nbsp;Tours&nbsp;on&nbsp;Sharing&nbsp;Basis</li></ul><p></p><p>Discover&nbsp;the&nbsp;vibrant&nbsp;beauty&nbsp;of&nbsp;Malaysia&nbsp;with&nbsp;an&nbsp;unforgettable&nbsp;journey&nbsp;through&nbsp;modern&nbsp;cities,&nbsp;rich&nbsp;culture,&nbsp;and&nbsp;tropical&nbsp;escapes.&nbsp;Explore&nbsp;the&nbsp;iconic&nbsp;skyline&nbsp;of&nbsp;Kuala&nbsp;Lumpur,&nbsp;experience&nbsp;the&nbsp;heritage&nbsp;charm&nbsp;of&nbsp;George&nbsp;Town,&nbsp;and&nbsp;relax&nbsp;on&nbsp;the&nbsp;stunning&nbsp;beaches&nbsp;of&nbsp;Langkawi.&nbsp;With&nbsp;comfortable&nbsp;accommodation,&nbsp;daily&nbsp;breakfast,&nbsp;guided&nbsp;tours,&nbsp;and&nbsp;airport&nbsp;transfers&nbsp;included,&nbsp;this&nbsp;package&nbsp;offers&nbsp;the&nbsp;perfect&nbsp;blend&nbsp;of&nbsp;adventure,&nbsp;culture,&nbsp;and&nbsp;relaxation.</p>', NULL, 'MALAYSIA', '4.5', 'services/1778068010670-ar90dlj6nsu.jpg', '[]', 'packages', NULL, NULL, NULL, '2026-05-06 11:50:45.188+00', '2026-05-08 06:13:01.078+00', '[]', '[]', NULL, 'active', NULL, NULL, '["services/1778068568718-ux7mphiggg.jpg", "services/1778068639688-qo7kzbh1lub.jpg"]', '', '', NULL, '[]', NULL, '["Cost of package per person sharing double room"]', '["1. Accommodation (hotels, resorts, or apartments)", "2. Airport transfers (in many mid/high-tier packages)", "3. Guided tours or sightseeing (depending on the itinerary)", "4. Transport between destinations (bus, train, or internal flights)"]', '["1. Exclude Air ticket ", "2. Travel insurance \ud83d\udee1\ufe0f", "3. Visa fees & documentation \ud83d\udec2", "4. Meals & drinks"]', NULL, '<p><span style="background-color: rgb(255, 255, 255); color: rgb(34, 34, 34);">*&nbsp;Conditions&nbsp;apply,&nbsp;subject&nbsp;to&nbsp;availability</span></p>', NULL, 'services/1778068200455-mj3uz1zw09c.jpg', False, 0, 'services/1778068084510-st11sn3xaxc.jpeg', False, 'Limited Time', True, False, 'Escape to Malaysia — City Vibes, Sky Rides & Iconic Adventures Await', NULL, NULL, 12, '[{"id": "1778078696416", "label": "All inclusive with Drinks"}]', NULL, '0', NULL),
('c38d5bf8-22ec-46c9-a0ae-d75811357912', 'Lagoon Attitude Hotel', '<p><span style="background-color: rgb(237, 244, 247); color: rgb(78, 89, 101);">Welcome&nbsp;to&nbsp;4*&nbsp;Lagoon&nbsp;Attitude&nbsp;hotel,&nbsp;a</span><strong style="background-color: rgb(237, 244, 247); color: rgb(78, 89, 101);">&nbsp;paradise&nbsp;for&nbsp;nature&nbsp;and&nbsp;sea&nbsp;lovers</strong><span style="background-color: rgb(237, 244, 247); color: rgb(78, 89, 101);">!</span></p><p></p><p><span style="background-color: rgb(237, 244, 247); color: rgb(78, 89, 101);">Located&nbsp;on&nbsp;the&nbsp;edge&nbsp;of&nbsp;the&nbsp;immense&nbsp;Anse&nbsp;la&nbsp;Raie&nbsp;lagoon&nbsp;on&nbsp;the&nbsp;north&nbsp;coast&nbsp;of&nbsp;Mauritius,&nbsp;the&nbsp;4*&nbsp;Lagoon&nbsp;Attitude&nbsp;hotel&nbsp;is&nbsp;our&nbsp;most&nbsp;</span><strong style="background-color: rgb(237, 244, 247); color: rgb(3, 170, 201);"><a href="https://hotels-attitude.com/en/positive-impact" rel="noopener noreferrer" target="_blank">eco-committed</a></strong><span style="background-color: rgb(237, 244, 247); color: rgb(78, 89, 101);">&nbsp;property.&nbsp;Thanks&nbsp;to&nbsp;our</span><strong style="background-color: rgb(237, 244, 247); color: rgb(78, 89, 101);">&nbsp;efforts&nbsp;in&nbsp;environmental&nbsp;and&nbsp;social&nbsp;responsibility</strong><span style="background-color: rgb(237, 244, 247); color: rgb(78, 89, 101);">,&nbsp;the&nbsp;hotel&nbsp;has&nbsp;been&nbsp;Travelife&nbsp;Gold&nbsp;certified&nbsp;since&nbsp;2017&nbsp;and&nbsp;Lagoon&nbsp;Attitude&nbsp;is&nbsp;continuing&nbsp;its&nbsp;focus&nbsp;on</span><strong style="background-color: rgb(237, 244, 247); color: rgb(78, 89, 101);">&nbsp;sustainable&nbsp;tourism</strong><span style="background-color: rgb(237, 244, 247); color: rgb(78, 89, 101);">.</span></p><p></p><p><span style="background-color: rgb(237, 244, 247); color: rgb(78, 89, 101);">In&nbsp;addition&nbsp;to&nbsp;our&nbsp;upcycling&nbsp;activity,&nbsp;the&nbsp;‘blue&nbsp;nets’&nbsp;program&nbsp;for&nbsp;litter&nbsp;picking&nbsp;and&nbsp;our&nbsp;zero&nbsp;single-use&nbsp;plastic&nbsp;policy,&nbsp;we&nbsp;have&nbsp;created&nbsp;the&nbsp;Marine&nbsp;Discovery&nbsp;Centre,&nbsp;which&nbsp;is&nbsp;dedicated&nbsp;to&nbsp;the&nbsp;preservation&nbsp;of&nbsp;the&nbsp;marine&nbsp;ecosystem.</span></p><p></p><p><span style="background-color: rgb(237, 244, 247); color: rgb(78, 89, 101);">Lagoon&nbsp;Attitude&nbsp;has&nbsp;also&nbsp;an&nbsp;</span><strong style="background-color: rgb(237, 244, 247); color: rgb(78, 89, 101);">idyllic&nbsp;location&nbsp;for&nbsp;windsurfing&nbsp;and&nbsp;kitesurfing&nbsp;in&nbsp;Mauritius</strong><span style="background-color: rgb(237, 244, 247); color: rgb(78, 89, 101);">.&nbsp;Its&nbsp;typical&nbsp;Mauritian&nbsp;architecture&nbsp;and&nbsp;natural&nbsp;decoration&nbsp;offer&nbsp;a&nbsp;peaceful&nbsp;Mauritian&nbsp;stay.</span></p><p></p><p>CHECK&nbsp;IN&nbsp;:&nbsp;14&nbsp;HRS</p><p>CHECK&nbsp;OUT&nbsp;:&nbsp;12&nbsp;HRS</p>', 'Anse La Raie', 'Mauritius', '4.5', 'services/1777704047302-14yo25qauah.jpg', '["Free wifi", "Beach towels", "Foreign currency exchange", "Free mineral sunscreen", "Medical care service", "Laundry Services", "24h reception and security services", "parking", "Restaurants & Bar", "spa", "entertainment", "Water activities", "3 Swimming Pools", "land activities", "gym"]', 'hotel', NULL, NULL, NULL, '2026-05-02 06:50:23.966+00', '2026-05-04 10:06:22.514+00', '[]', '[]', NULL, 'active', NULL, NULL, '["services/1777704220852-u4waxga4en.jpg", "services/1777704232046-4vdxo2q4ns2.jpg", "services/1777704239855-r36fk8t4u1e.webp", "services/1777704252351-ea7mzeqmok5.webp", "services/1777704260546-c3rkhg24giw.webp", "services/1777704279878-11c2r81ybnyg.jpg", "services/1777704299759-rqhmibwmmo.webp", "services/1777704312429-6fvkof1w0ow.jpg"]', '', '', NULL, '[]', NULL, '[]', '[]', '[]', '<p>The&nbsp;applicable&nbsp;cancellation&nbsp;policy&nbsp;shall&nbsp;be&nbsp;as&nbsp;follows&nbsp;:</p><p>Cancellation&nbsp;date/period&nbsp;</p><p>Rate&nbsp;payable</p><p>Between&nbsp;D-7&nbsp;and&nbsp;D-4:&nbsp;50%&nbsp;of&nbsp;total&nbsp;rate&nbsp;payable</p><p>Between&nbsp;D-3&nbsp;and&nbsp;D-1:&nbsp;80%&nbsp;of&nbsp;total&nbsp;rate&nbsp;payable</p><p>Peak&nbsp;season&nbsp;between&nbsp;D-30&nbsp;and&nbsp;D-1:&nbsp;100%&nbsp;of&nbsp;total&nbsp;rate&nbsp;payable</p><p>No&nbsp;shows:&nbsp;100%&nbsp;of&nbsp;total&nbsp;rate&nbsp;payable</p><p>Unexpected&nbsp;departure:&nbsp;No&nbsp;refund.&nbsp;</p><p>&nbsp;</p>', '<p>Rates&nbsp;are&nbsp;in&nbsp;MUR&nbsp;per&nbsp;room&nbsp;per&nbsp;night&nbsp;on&nbsp;&#39;Half&nbsp;Board&#39;&nbsp;basis&nbsp;[&nbsp;Breakfast&nbsp;&amp;&nbsp;Dinner&nbsp;].</p><p></p><p>Minimum&nbsp;of&nbsp;2-night&nbsp;stay&nbsp;for&nbsp;All&nbsp;inclusive&nbsp;basis&nbsp;and&nbsp;Half&nbsp;&amp;&nbsp;Full&nbsp;board&nbsp;basis&nbsp;for&nbsp;1&nbsp;night&nbsp;stay.</p><p>&nbsp;</p><p>MLOS&nbsp;3&nbsp;nights&nbsp;is&nbsp;to&nbsp;be&nbsp;applied&nbsp;for&nbsp;below&nbsp;dates.</p><p>Chinese&nbsp;Spring&nbsp;Festival&nbsp;-&nbsp;16th&nbsp;to&nbsp;19th&nbsp;February&nbsp;2026</p><p>Independence&nbsp;Day&nbsp;&nbsp;-&nbsp;12th&nbsp;to&nbsp;15hth&nbsp;March&nbsp;2026</p><p>Ugaadi&nbsp;-&nbsp;19th&nbsp;to&nbsp;22nd&nbsp;March&nbsp;2026</p><p>Labour&nbsp;day&nbsp;-&nbsp;1st&nbsp;to&nbsp;3rd&nbsp;May&nbsp;2026</p><p>&nbsp;</p>', NULL, 'services/1777704068469-ovae7zb8reb.webp', False, 0, 'services/1777704090515-7clqv9vaiwq.jpg', False, 'Limited Time', True, False, 'Lagoon Attitude is a peaceful adults-only beachfront hotel in Mauritius, known for its eco-friendly approach, relaxing atmosphere, and beautiful lagoon views.', NULL, NULL, 12, '["All Inclusive", {"id": "1777885755595", "label": "Half Board"}, {"id": "1777885851393", "label": "All Inclusive"}]', NULL, '0', NULL),
('b494e985-db25-48a9-b3f3-0dbd84c43c53', 'Ocean V Hotel', '<p>Nested&nbsp;in&nbsp;the&nbsp;North&nbsp;of&nbsp;the&nbsp;tropical&nbsp;island&nbsp;of&nbsp;Mauritius&nbsp;in&nbsp;front&nbsp;of&nbsp;a&nbsp;calm&nbsp;and&nbsp;beautiful&nbsp;bay&nbsp;of&nbsp;the&nbsp;north.&nbsp;Ideal&nbsp;for&nbsp;a&nbsp;fun&nbsp;and&nbsp;exciting&nbsp;stay&nbsp;for&nbsp;leisure,&nbsp;business&nbsp;travelers&nbsp;and&nbsp;for&nbsp;tourists&nbsp;exploring&nbsp;around&nbsp;the&nbsp;island.</p><p>Newly&nbsp;built,&nbsp;this&nbsp;art&nbsp;boutique&nbsp;hotel&nbsp;opened&nbsp;its&nbsp;doors&nbsp;in&nbsp;November&nbsp;2019.&nbsp;It&nbsp;is&nbsp;a&nbsp;brand&nbsp;new&nbsp;property&nbsp;overlooking&nbsp;the&nbsp;beautiful&nbsp;Grand&nbsp;Baie.&nbsp;It&nbsp;consists&nbsp;of&nbsp;38&nbsp;rooms&nbsp;beautiful&nbsp;designed&nbsp;on&nbsp;two&nbsp;levels&nbsp;(1st&nbsp;&amp;&nbsp;2nd&nbsp;floor).&nbsp;The&nbsp;hotel&nbsp;has&nbsp;a&nbsp;unique&nbsp;rooftop&nbsp;experience&nbsp;that&nbsp;includes&nbsp;an&nbsp;Infinity&nbsp;Pool,&nbsp;a&nbsp;Restaurant&nbsp;and&nbsp;a&nbsp;Bar&nbsp;&amp;&nbsp;Lounge,&nbsp;the&nbsp;hotel&nbsp;also&nbsp;boasts&nbsp;a&nbsp;specialty&nbsp;Chinese&nbsp;restaurant,&nbsp;Café,&nbsp;Spa&nbsp;and&nbsp;Reception.&nbsp;It&nbsp;is&nbsp;the&nbsp;fifth&nbsp;addition&nbsp;to&nbsp;the&nbsp;Sea&nbsp;Resorts&nbsp;Group&nbsp;in&nbsp;Mauritius.</p><p>This&nbsp;hotel&nbsp;is&nbsp;200m&nbsp;walking&nbsp;distance&nbsp;from&nbsp;the&nbsp;famous&nbsp;Pereybere&nbsp;which&nbsp;is&nbsp;well-known&nbsp;for&nbsp;its&nbsp;fine&nbsp;sandy&nbsp;beach&nbsp;and&nbsp;best&nbsp;swim&nbsp;in&nbsp;the&nbsp;north&nbsp;of&nbsp;the&nbsp;island.</p><p>Adults-only&nbsp;hotel&nbsp;(as&nbsp;from&nbsp;16&nbsp;years)</p><p></p><p></p><p>CHECK&nbsp;IN&nbsp;:&nbsp;14&nbsp;HRS</p><p>CHECK&nbsp;OUT&nbsp;:&nbsp;11&nbsp;HRS</p>', 'Pereybere', 'North Coast', '4.5', 'services/1778217269980-xjqn2pql1u.jpg', '["Free wifi", "swimming pool", "Restaurant & Bar", "GYM", "spa"]', 'hotel', NULL, NULL, NULL, '2026-05-08 05:26:56.036+00', '2026-05-08 07:17:07.974+00', '[]', '[]', NULL, 'active', NULL, NULL, '["services/1778217875559-3taq0a2myiu.jpg", "services/1778217899628-4y387ofea6u.jpg", "services/1778217910200-tchlcch1els.jpg", "services/1778217920137-71pb52dkgxt.jpg", "services/1778217934819-k5crb2cull.webp", "services/1778217951016-898s49ih6de.webp", "services/1778217959143-z3biv7acux.webp", "services/1778217979896-9mv547vd91h.webp", "services/1778217991780-fmqy1u0dgm9.jpg", "services/1778218005160-u16vaszuqt.jpg"]', '', '', NULL, '[]', NULL, '[]', '[]', '[]', NULL, '<p></p>', NULL, 'services/1778217359202-ggzvcbd8d04.jpg', False, 0, 'services/1778217338047-ogvbu4u1kuk.webp', False, 'Limited Time', True, False, 'Ocean V Hotel is a modern adults-only hotel near the beach in Grand Baie, Mauritius, with ocean views and a rooftop pool.', NULL, NULL, 12, '[{"id": "1778220715511", "label": "Bed & Breakfast"}, {"id": "1778220778823", "label": "Half Board"}, {"id": "1778220786686", "label": "All Inclusive"}]', NULL, '0', NULL),
('ab75c749-1147-4950-abd3-5299f81fddee', ' Cape Town Group tour', '<ul><li>Air&nbsp;Ticket&nbsp;With&nbsp;South&nbsp;African&nbsp;Airways</li><li>&nbsp;7&nbsp;Nights&nbsp;Stay&nbsp;At&nbsp;Cresta&nbsp;Grand&nbsp;Hotel,&nbsp;4*&nbsp;Or&nbsp;Similar&nbsp;</li><li>Daily&nbsp;Breakfast</li><li>Return&nbsp;Airport&nbsp;Transfer&nbsp;</li><li>City&nbsp;Tour&nbsp;Including&nbsp;Table&nbsp;Mountain</li><li>Cape&nbsp;Peninsula&nbsp;Tour&nbsp;Includes&nbsp;Seal&nbsp;Island&nbsp;Boat&nbsp;,&nbsp;Cape&nbsp;Point&nbsp;&amp;&nbsp;Boulders&nbsp;Beach</li><li>Entry&nbsp;Fees&nbsp;To&nbsp;All&nbsp;Sites</li></ul><p></p><pre data-language="plain">
Discover the beauty of Cape Town with an unforgettable escape filled with iconic landmarks, breathtaking coastal views, and world-famous attractions. 
</pre>', 'CAPE TOWN', 'SOUTH AFRICA', '4.5', 'services/1778234075227-5tnd2mp6ttj.jpg', '[]', 'tour', NULL, NULL, NULL, '2026-05-08 09:57:45.022+00', '2026-05-08 11:23:49.114+00', '[]', '[{"day": "Day 1", "time": "", "title": "Arrive Airport, Meet & Greet by our representative ", "image_url": "", "description": ""}, {"day": "Day 2", "time": "", "title": "Guided Cape Town City Tour including city highlights, historic areas, and scenic coastal drives + Visit to Table Mountain (weather permitting) and exploration of Bo-Kaap and city centre.", "image_url": "", "description": ""}, {"day": "Day 3", "time": "", "title": "Free for leisure ", "image_url": "", "description": ""}, {"day": "Day 4", "time": "", "title": "Cape Peninsula Full Day Tour / Full-day Cape Peninsula Tour including:", "image_url": "", "description": "<p></p><ul><li>&nbsp;&nbsp;Seal&nbsp;Island&nbsp;Boat&nbsp;Trip&nbsp;at&nbsp;Seal&nbsp;Island</li><li>&nbsp;&nbsp;Scenic&nbsp;drive&nbsp;via&nbsp;Chapman&#39;s&nbsp;Peak&nbsp;Drive</li><li>&nbsp;&nbsp;Visit&nbsp;to&nbsp;Cape&nbsp;Point&nbsp;(Funicular&nbsp;Included)</li><li>&nbsp;&nbsp;Visit&nbsp;to&nbsp;Boulders&nbsp;Beach</li></ul>"}, {"day": "Day 5", "time": "", "title": "Free for leisure", "image_url": "", "description": ""}, {"day": "Day 6", "time": "", "title": "Free for leisure", "image_url": "", "description": ""}, {"day": "Day 7", "time": "", "title": "Free for leisure", "image_url": "", "description": ""}, {"day": "Day 8", "time": "", "title": "Departure from Cape Town to Mauritius ", "image_url": "", "description": ""}]', NULL, 'active', NULL, NULL, '[]', '', '', NULL, '[]', NULL, '["Travelling date: 19 Nov \u2013 26 Nov 2026", "Cost of package per person sharing double room"]', '[]', '[]', NULL, '<p><span style="color: rgb(34, 34, 34); background-color: rgb(255, 255, 255);">Conditions&nbsp;apply,&nbsp;subject&nbsp;to&nbsp;availability</span></p>', NULL, 'services/1778239408241-x1ellon5sq.jpg', False, 0, 'services/1778239419979-kg25zqnuc5m.jpg', False, 'Limited Time', True, False, 'Experience the magic of Cape Town — breathtaking landscapes, iconic adventures, and unforgettable moments in one extraordinary escape!', NULL, NULL, 12, '[]', NULL, '0', NULL),
('9d86212b-1552-41ce-8032-7ee8fd6707fe', 'Ocean''s Creek Beach Hotel', '<p><span style="background-color: rgb(254, 254, 254); color: rgb(103, 105, 118);">Managed&nbsp;by&nbsp;Shanti&nbsp;Hospitality,&nbsp;Ocean&#39;s&nbsp;Creek&nbsp;Beach&nbsp;Hotel&nbsp;has&nbsp;nested&nbsp;on&nbsp;the&nbsp;coastal&nbsp;northwest&nbsp;of&nbsp;Mauritius,&nbsp;near&nbsp;Balaclava.&nbsp;With&nbsp;its&nbsp;strategic&nbsp;location,&nbsp;the&nbsp;hotel&nbsp;is&nbsp;accessible&nbsp;to&nbsp;every&nbsp;part&nbsp;of&nbsp;Mauritius,&nbsp;discovering&nbsp;the&nbsp;culture&nbsp;and&nbsp;nature&nbsp;experience&nbsp;of&nbsp;the&nbsp;island.&nbsp;The&nbsp;hotel&nbsp;offers&nbsp;splendid&nbsp;view&nbsp;of&nbsp;the&nbsp;Tombeau&nbsp;River&nbsp;and&nbsp;Le&nbsp;Goulet&nbsp;Beach,&nbsp;offering&nbsp;a&nbsp;warm&nbsp;sunset&nbsp;by&nbsp;the&nbsp;end&nbsp;of&nbsp;the&nbsp;day.&nbsp;With&nbsp;365&nbsp;days&nbsp;of&nbsp;versatile&nbsp;fun,&nbsp;Ocean&#39;s&nbsp;Creek&nbsp;ensures&nbsp;a&nbsp;vibrant&nbsp;guest&nbsp;experience&nbsp;with&nbsp;its&nbsp;team.</span></p><p></p><p>Check-in&nbsp;at&nbsp;14:00</p><p>Check-out&nbsp;11:00.</p>', 'Balaclava', 'Mauritius', '4.5', 'services/1777544979317-7689fp46j2w.jpg', '["Wifi ", "In-house Cinema", " Laundry service", "spa", "gym", "Up to 50 parking places and coach parking", "Water Leisure - Pool & Jacuzzi", "Kids Club", "Indoor & Outdoor Activities"]', 'hotel', NULL, NULL, NULL, '2026-04-30 10:39:15.773+00', '2026-04-30 10:41:50.077+00', '[]', '[]', NULL, 'active', NULL, NULL, '["services/1777545040285-k6q0a87zs9c.jpg", "services/1777545051493-7kxrofg188e.jpg", "services/1777545092213-u7v171yantc.jpg", "services/1777545099676-dt17a99janu.jpg"]', '', '', NULL, '[]', NULL, '[]', '[]', '[]', '<p>(No&nbsp;show,&nbsp;shortening&nbsp;of&nbsp;stay,&nbsp;unexpected&nbsp;departure,&nbsp;etc.):</p><p><strong>100%&nbsp;of&nbsp;the&nbsp;total&nbsp;booking&nbsp;value/charges</strong>&nbsp;will&nbsp;be&nbsp;applicable,&nbsp;as&nbsp;from&nbsp;confirmation&nbsp;date.</p>', '<ul><li><ul><li>The&nbsp;above&nbsp;rates&nbsp;are&nbsp;quoted&nbsp;in&nbsp;<strong>MUR</strong>,&nbsp;on&nbsp;<strong>All-Inclusive&nbsp;basis</strong>,&nbsp;and&nbsp;inclusive&nbsp;of&nbsp;all&nbsp;charges.</li><li>Applicable&nbsp;only&nbsp;to&nbsp;<u>new&nbsp;bookings</u>.&nbsp;</li><li>Note&nbsp;that&nbsp;the&nbsp;rooms&nbsp;will&nbsp;be&nbsp;subject&nbsp;to&nbsp;availability&nbsp;upon&nbsp;booking&nbsp;time.</li><li>Check-in&nbsp;at&nbsp;14:00&nbsp;and&nbsp;Check-out&nbsp;11:00.</li><li>Other&nbsp;T&amp;Cs&nbsp;apply.</li></ul></li></ul>', NULL, 'services/1777545007002-cqaqx5iavxl.jpg', False, 0, 'services/1777545016824-dn4hf3bn41.jpg', False, 'Limited Time', True, False, 'Managed by Shanti Hospitality, Ocean''s Creek Beach Hotel has nested on the coastal northwest of Mauritius, near Balaclava.', NULL, NULL, 12, '[{"id": "1778141488777", "label": "All inclusive"}]', NULL, '0', NULL),
('59484ee7-c5de-4699-870d-d9e73cb8305c', 'Go Sun Beach Residence', '<p>GoSun&nbsp;Beach&nbsp;Residence&nbsp;is&nbsp;a&nbsp;beachfront&nbsp;hotel&nbsp;in&nbsp;Flic&nbsp;en&nbsp;Flac,&nbsp;Mauritius.&nbsp;It&nbsp;offers&nbsp;modern&nbsp;rooms,&nbsp;a&nbsp;swimming&nbsp;pool,&nbsp;restaurant,&nbsp;free&nbsp;Wi-Fi,&nbsp;and&nbsp;sea&nbsp;views.&nbsp;The&nbsp;hotel&nbsp;is&nbsp;close&nbsp;to&nbsp;the&nbsp;beach,&nbsp;shops,&nbsp;and&nbsp;restaurants,&nbsp;making&nbsp;it&nbsp;good&nbsp;for&nbsp;couples,&nbsp;families,&nbsp;and&nbsp;tourists.</p>', 'Flic en Flac', 'West Coast', '4.5', 'services/1778218865576-kbg412edvr.jpg', '[]', 'hotel', NULL, NULL, NULL, '2026-05-08 05:45:45.334+00', '2026-05-08 05:45:45.333+00', '[]', '[]', NULL, 'active', NULL, NULL, '["services/1778218920594-pcphblqfb1.jpg", "services/1778218932354-t5r9wo4pyt.webp", "services/1778218945623-h1mhvnzuwyc.jpg", "services/1778218960489-yfkw2ydi3f.jpg", "services/1778218969646-nrdq483qgbp.jpg", "services/1778218982065-vbp2jbud1j.webp", "services/1778219116297-k8zth0fpaq.jpg", "services/1778219134316-wjobi563fw.jpg"]', '', '', NULL, '[]', NULL, '[]', '[]', '[]', NULL, NULL, NULL, 'services/1778218893262-etz5qwi7jwj.webp', False, 0, 'services/1778218904356-3hct6plgs22.jpg', False, 'Limited Time', True, False, 'GoSun Beach Residence is a beachfront hotel in Mauritius with sea-view rooms, pool, Wi-Fi, and easy beach access.', NULL, NULL, 12, '[{"id": "1778220153551", "label": "Bed & Breakfast"}]', NULL, '0', NULL)
