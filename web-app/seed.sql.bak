INSERT INTO public."hero_slides" ("id", "image_url", "subtitle", "title", "description", "cta_text", "cta_link", "order_index", "is_active", "created_at", "updated_at", "video_url", "media_type", "alignment", "overlay_opacity", "tag", "cta", "link", "animation_type", "duration", "start_date", "end_date", "mobile_image_url", "badge_text", "badge_color") VALUES
('d05e73ff-fa69-4010-9111-580a554890da', 'hero-slides/1776357109003-f0ypot8h95u.webp', 'Experience the world through a seamless blend of breathtaking destinations.', 'Extraordinary Journeys', '', 'Explore Now', '/search', -1, True, '2026-04-12 11:27:44.410991+00', '2026-04-16 16:31:55.332688+00', '', 'image', 'center', 0.4, NULL, NULL, NULL, 'ken-burns', 6000, NULL, NULL, '', 'NEW DESTINATIONS', '#EF4444'),
('88b27651-7b6a-49a2-93c6-f05813275d42', 'hero-slides/1776357150355-rltdasgsub.webp', 'Elevate Your Journey', 'Packaged Flights', 'Travel in comfort and style with our airline partnerships.', 'Book Flight', '/flights', 0, True, '2026-03-10 17:35:32.137019+00', '2026-04-16 16:32:34.634949+00', '', 'image', 'center', 0.4, NULL, NULL, NULL, 'slide-up', 6000, NULL, NULL, '', '', '#EF4444'),
('cfbff15a-cb2c-4d8f-9c71-c2f9c2a34eb2', 'hero-slides/1776362478251-6on9yin92k5.webp', 'Sail in Style', 'Luxe Cruises', 'Experience the ultimate luxury on the high seas with our curated cruise collections.', 'View Cruises', '/cruises', 1, True, '2026-03-10 17:35:32.137019+00', '2026-04-16 18:01:58.277337+00', '', 'image', 'center', 0.4, NULL, NULL, NULL, 'fade', 6000, '2026-04-01 22:01:00+00', '2026-05-31 22:01:00+00', '', 'Summer Sales', '#EF4444'),
('ced73a23-95f8-444e-89af-657b06148f5f', '/assets/placeholders/hero-adventure.png', 'Explore the Unseen', 'Adventure Awaits', 'Discover hidden gems and breathtaking landscapes with our adventure packages.', 'Explore Now', '/activities', 3, True, '2026-03-10 17:35:32.137019+00', '2026-03-24 13:13:00.075605+00', NULL, 'image', 'center', 0.4, NULL, NULL, NULL, 'fade', 6000, NULL, NULL, NULL, NULL, '#EF4444'),
('7abc86ce-722d-4ddc-9d78-a0900dce950b', 'hero-slides/1776362597164-1dsr94dp8vh.jpg', 'Luxury Redefined', 'Exquisite Stays', 'From boutique hotels to 5-star resorts, find your perfect home away from home.', 'Find Hotels', '/hotels', 2, True, '2026-03-10 17:35:32.137019+00', '2026-04-16 18:03:23.258571+00', '', 'image', 'center', 0.4, NULL, NULL, NULL, 'fade', 6000, NULL, NULL, '', '', '#EF4444')
