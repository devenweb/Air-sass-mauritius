-- Data for email_templates (21 rows)
INSERT INTO public."email_templates" ("id", "name", "subject", "body", "variables", "created_at", "updated_at") VALUES
('61cc2fad-7a61-4763-a729-58d617309892', 'order_confirmation', 'Your Order is Confirmed!', 'Hi {{customer_name}},\n\nThank you for choosing RoyalTravel! We have received your order #{{order_id}} for a total of {{total_amount}} MUR. Our team is preparing everything for you.\n\nWarm regards,\nThe RoyalTravel Team', '{"order_id": "Order Reference", "total_amount": "Total Price", "customer_name": "Customer Name"}', '2026-03-10 05:41:49.370314', '2026-03-10 05:41:49.370314'),
('3890cd55-a04b-42af-9320-2d52dc05e356', 'Welcome Sequence v2', 'Welcome to the Royal Travel Inner Circle', '<h1>Hello {{name}}</h1><p>Thank you for joining our exclusive list of travelers. Get ready for premium deals and expert advice.</p>', '{"name": "string", "site_url": "url"}', '2026-03-16 05:58:40.259778', '2026-03-16 05:58:40.259778'),
('3f0a22cc-2917-4ce5-991f-4486a5f187e5', 'T1', NULL, NULL, '[]', '2026-03-16 08:08:32.704913', '2026-03-16 08:08:32.704913'),
('8ea41e16-44f4-4a0c-a471-19097e9ec618', 'T2', NULL, NULL, '[]', '2026-03-16 08:08:32.704913', '2026-03-16 08:08:32.704913'),
