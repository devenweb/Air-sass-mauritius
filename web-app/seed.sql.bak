-- Data for popup_ads (8 rows)
INSERT INTO public."popup_ads" ("id", "title", "content", "media_url", "media_type", "cta_text", "cta_link", "is_active", "display_frequency", "start_at", "end_at", "created_at", "updated_at", "popup_type") VALUES
('21592a4d-3818-4f90-a14c-382fda3e1afc', 'Exclusive App Offer', 'Download the Royal Travel app and get an additional 5% off your first booking. Use code: APPLOUNGE', 'https://images.unsplash.com/photo-1512941937669-90a1b58e7e9c?auto=format&fit=crop&q=80&w=1200', 'image', 'Download Now', '/app-download', True, 'once_per_day', '2026-03-11 20:48:02.118724+00', '2027-03-11 20:48:02.118724+00', '2026-03-11 20:48:02.118724+00', '2026-03-11 20:48:02.118724+00', 'standard'),
('c881c31d-61c4-4912-8c2c-cac4a969afd5', 'LOYALTY LOUNGE: 10% OFF', 'Join our Loyalty Lounge today and unlock an instant 10% discount on your next flight booking. Luxury starts with us.', 'https://images.unsplash.com/photo-1512941937669-90a1b58e7e9c?auto=format&fit=crop&q=80&w=1200', 'image', 'JOIN THE LOUNGE', '/auth/signup', True, 'once_per_session', NULL, NULL, '2026-04-11 16:32:05.497922+00', '2026-04-11 16:32:05.497922+00', 'standard'),
('0c337bf4-0667-4f7c-86a2-f801fb4de0b4', 'THE ULTIMATE ESCAPE', '<ul><li><ul><li>2&nbsp;Nights&nbsp;stay&nbsp;in&nbsp;Athens,&nbsp;Casual&nbsp;Kubic&nbsp;Athens&nbsp;or&nbsp;similar&nbsp;<span class="ql-size-small"></span></li><li>2&nbsp;Nights&nbsp;stay&nbsp;in&nbsp;Santorini,&nbsp;Hotel&nbsp;Santorini&nbsp;or&nbsp;similar&nbsp;</li><li>Bed&nbsp;&amp;&nbsp;breakfast&nbsp;</li><li>Airport&nbsp;transfer&nbsp;</li><li>Athens&nbsp;Half&nbsp;Day&nbsp;City&nbsp;Tour&nbsp;with&nbsp;Acropolis&nbsp;+&nbsp;Acropolis&nbsp;Museum</li><li>Full&nbsp;day&nbsp;Santorini&nbsp;Traditional&nbsp;Bus&nbsp;tour&nbsp;with&nbsp;Sunset&nbsp;in&nbsp;Oia</li><li>Transfer&nbsp;from&nbsp;Santorini&nbsp;Ferry&nbsp;Port&nbsp;–&nbsp;Hotel&nbsp;and&nbsp;back&nbsp;</li></ul></li></ul><p class="ql-align-justify"></p><p></p>', 'https://images.unsplash.com/photo-1544644181-1484b3fdfc62?auto=format&fit=crop&q=80&w=1200', 'image', 'START YOUR JOURNEY', '/packages', True, 'once_per_day', NULL, NULL, '2026-04-11 16:32:05.497922+00', '2026-04-11 16:32:05.497922+00', 'standard'),
('8e8470ad-75c4-4c43-a6a5-5f2caa1cb595', 'test', '', 'https://tbyudagfjspedeqtlgjv.supabase.co/storage/v1/object/public/bucket/popups/popup-lw8vpc6kwz-1777982256143.jpg', 'image', 'Learn More', '', True, 'always', NULL, NULL, '2026-05-05 11:57:40.883544+00', '2026-05-05 11:57:40.883544+00', 'standard'),
('1cf1f955-d58e-4dfc-9adf-1ff13cf796b4', 'Image Ad - 5/7/2026', '', 'https://tbyudagfjspedeqtlgjv.supabase.co/storage/v1/object/public/bucket/popups/popup-3jd4qcby7ft-1778135369974.jpg', 'image', 'Learn More', '/search', True, 'always', NULL, NULL, '2026-05-07 06:29:36.679938+00', '2026-05-07 06:29:36.679938+00', 'image_only'),
('ed3a3eeb-6b30-4585-9819-ca44c8305f24', 'test', '<p></p>', 'https://tbyudagfjspedeqtlgjv.supabase.co/storage/v1/object/public/bucket/popups/popup-ait7qx4sakt-1777982156011.jpg', 'image', 'Learn More', '', True, 'always', NULL, NULL, '2026-05-05 11:51:06.430419+00', '2026-05-05 11:51:06.430419+00', 'standard'),
