('c4444adb-e126-4262-8684-bb6de84f04f3', 'T5', NULL, NULL, '[]', '2026-03-16 08:08:32.704913', '2026-03-16 08:08:32.704913'),
('e47fe489-07d2-4bc0-9911-8a603ccf7af5', 'T6', NULL, NULL, '[]', '2026-03-16 08:08:32.704913', '2026-03-16 08:08:32.704913'),
('57cf41dc-45c8-4993-b164-d4137034e58a', 'T7', NULL, NULL, '[]', '2026-03-16 08:08:32.704913', '2026-03-16 08:08:32.704913'),
('463ce501-5cef-4a12-b696-13acfc66111d', 'T8', NULL, NULL, '[]', '2026-03-16 08:08:32.704913', '2026-03-16 08:08:32.704913'),
('fc81c0f9-bc93-49c1-bcc2-0792dd00fece', 'T9', NULL, NULL, '[]', '2026-03-16 08:08:32.704913', '2026-03-16 08:08:32.704913'),
('8405879d-7fde-4faf-9c6f-f37f9e5e9607', 'T10', NULL, NULL, '[]', '2026-03-16 08:08:32.704913', '2026-03-16 08:08:32.704913'),
('f9d7a986-e216-492f-9109-c1926e244cf8', 'T11', NULL, NULL, '[]', '2026-03-16 08:08:32.704913', '2026-03-16 08:08:32.704913'),
('bced6459-ecd2-4299-b22c-ec1ff32159d9', 'T12', NULL, NULL, '[]', '2026-03-16 08:08:32.704913', '2026-03-16 08:08:32.704913'),
('9a979e4f-cebb-4b51-9a57-b8853f900dc2', 'T13', NULL, NULL, '[]', '2026-03-16 08:08:32.704913', '2026-03-16 08:08:32.704913'),
('7f60d5d8-b8f6-4efa-ae28-da32723fd9d6', 'booking_confirmation', 'Booking Confirmation: {{service_name}} - TL-{{booking_id}}', '
      <h1 style="color: #111827; font-size: 24px; font-weight: 800; margin-bottom: 16px;">Booking Confirmation</h1>
      <p>Dear <strong>{{customer_name}}</strong>,</p>
      <p>{{intro_text}}</p>
      
      <div class="booking-details">
        <h4 style="margin: 0 0 15px 0; font-size: 14px; color: #DC2626; text-transform: uppercase; letter-spacing: 1px;">Reservation Summary</h4>
        
        <div class="detail-row">
            <span class="detail-label">Service</span>
            <span class="detail-value">{{service_name}}</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Booking ID</span>
            <span class="detail-value">#{{booking_id}}</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">{{label_start}}</span>
            <span class="detail-value">{{check_in}}</span>
        </div>
        <div style="display: {{show_checkout}}">
            <div class="detail-row">
                <span class="detail-label">{{label_end}}</span>
                <span class="detail-value">{{check_out}}</span>
            </div>
        </div>
        <div style="display: {{show_nights}}">
            <div class="detail-row">
                <span class="detail-label">Duration</span>
                <span class="detail-value">{{nights}}</span>
            </div>
        </div>
        <div class="detail-row">
            <span class="detail-label">Guests</span>
            <span class="detail-value">{{adults}} Adults, {{teens}} Teens, {{children}} Kids</span>
        </div>
        <div class="detail-row" style="border-bottom: none; padding-top: 15px;">
            <span class="detail-label" style="color: #111827; font-size: 14px;">Total Amount</span>
            <span class="detail-value" style="color: #DC2626; font-size: 18px; font-weight: 800;">{{total_price}}</span>
        </div>
      </div>

      <h4 style="font-size: 14px; font-weight: 800; color: #111827; margin: 30px 0 10px 0;">Your Preferences</h4>
      <p style="font-size: 14px; color: #4B5563; margin-bottom: 5px;"><strong>Meal Plan:</strong> {{meal_preference}}</p>
      <p style="font-size: 14px; color: #4B5563; margin-bottom: 5px;"><strong>Room Preference:</strong> {{room_preference}}</p>
      <p style="font-size: 14px; color: #4B5563; margin-bottom: 20px;"><strong>Additional Notes:</strong> {{notes}}</p>

      <p style="margin-top: 30px;">Our team will review your reservation and contact you shortly to finalize the details and payment arrangements.</p>
      <p>If you have any questions, please reply to this email or call us at +230 5940 7701.</p>
      
      <a href="https://royaltravel.mu" class="button">View My Booking</a>
    ', '{"amount": "Price", "currency": "MUR", "booking_id": "Ref", "service_name": "Experience", "customer_name": "Name"}', '2026-03-10 05:41:49.370314', '2026-05-05 16:45:08.260176'),
('a4115bc4-4f1e-4333-99e5-70d4030adfb0', 'subscription_welcome', 'Welcome to the Insider Lounge! 🌏', '<div style="font-family: sans-serif; max-width: 600px; margin: auto; background: linear-gradient(135deg, #e11d48 0%, #9f1239 100%); padding: 60px 40px; text-align: center; border-radius: 30px;">
    <h1 style="color: white; font-size: 32px; margin-bottom: 20px; font-weight: 900; letter-spacing: -1px;">You''re In!</h1>
    <p style="color: rgba(255,255,255,0.8); font-size: 18px; margin-bottom: 40px;">Welcome to the Travellounge community. You''ll now be the first to hear about exclusive local deals, global flight promos, and hidden gems.</p>
    <div style="background: rgba(255,255,255,0.1); padding: 20px; border-radius: 20px; color: white; display: inline-block;">
      <p style="font-weight: bold; margin: 0;">Verified Subscriber:</p>
      <p style="opacity: 0.7; margin: 0;">{{customer_email}}</p>
    </div>
  </div>', '{"customer_email": "Email"}', '2026-03-31 17:07:39.778173', '2026-03-31 17:07:39.778173'),
('6d481498-1d77-46bc-88f9-e33b8fe4fffb', 'admin_new_subscription', 'New Newsletter Subscription: {{customer_email}}', 'Hello Admin,\n\nA new user has subscribed to the newsletter.\n\nEmail: {{customer_email}}\nSource: {{source}}\n\nRegards,\nRoyal Travel System', '[]', '2026-04-29 17:11:31.733879', '2026-04-29 17:11:31.733879'),
('9f00ca5a-5fb5-4408-8dc3-8431ee355079', 'inquiry_received', 'We Received Your Inquiry: {{service_name}}', '
      <h1 style="color: #111827; font-size: 24px; font-weight: 800; margin-bottom: 16px;">Thank You for Your Inquiry</h1>
      <p>Dear <strong>{{customer_name}}</strong>,</p>
      <p>We''ve received your request regarding <strong>{{service_name}}</strong>. Our travel specialists are currently reviewing your requirements and will get back to you with a personalized quote shortly.</p>
      
      <div class="booking-details">
        <h4 style="margin: 0 0 15px 0; font-size: 14px; color: #DC2626; text-transform: uppercase; letter-spacing: 1px;">Inquiry Summary</h4>
        <div class="detail-row">
            <span class="detail-label">Destination</span>
            <span class="detail-value">{{destination}}</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Travel Date</span>
            <span class="detail-value">{{departure_date}}</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Guests</span>
            <span class="detail-value">{{adults}} Adults, {{children}} Kids</span>
        </div>
      </div>

      <h4 style="font-size: 14px; font-weight: 800; color: #111827; margin: 20px 0 10px 0;">Your Message</h4>
      <p style="background: #F8F9FA; padding: 20px; border-radius: 8px; border-left: 4px solid #DC2626; font-style: italic; color: #4B5563;">
        {{raw:message}}
      </p>

      <p style="margin-top: 30px;">In the meantime, feel free to browse our latest exclusive deals on our website.</p>
      
      <a href="https://royaltravel.mu/local-deals" class="button">Explore Exclusive Deals</a>
    ', '{"service_name": "Topic/Service", "customer_name": "Name"}', '2026-03-31 17:07:39.778173', '2026-05-05 16:45:09.15686'),
('f10495ed-c200-4c9f-a1f4-a0c4f8c028bf', 'admin_new_inquiry', '📩 NEW INQUIRY: {{customer_name}} - {{destination}}', '
      <h1 style="color: #111827; font-size: 24px; font-weight: 800; margin-bottom: 16px;">New Inquiry Received</h1>
      <p>A new request has been submitted through the website.</p>
      
      <div class="booking-details">
        <h4 style="margin: 0 0 15px 0; font-size: 14px; color: #DC2626; text-transform: uppercase; letter-spacing: 1px;">Lead Details</h4>
        <div class="detail-row">
            <span class="detail-label">Customer</span>
            <span class="detail-value">{{customer_name}}</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Email</span>
            <span class="detail-value">{{customer_email}}</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Phone</span>
            <span class="detail-value">{{customer_phone}}</span>
        </div>
      </div>

      <div class="booking-details">
        <h4 style="margin: 0 0 15px 0; font-size: 14px; color: #DC2626; text-transform: uppercase; letter-spacing: 1px;">Trip Summary</h4>
        <div class="detail-row">
            <span class="detail-label">Destination</span>
            <span class="detail-value">{{destination}}</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Date</span>
            <span class="detail-value">{{departure_date}}</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Guests</span>
            <span class="detail-value">{{adults}} Adults, {{children}} Kids</span>
        </div>
      </div>

      <h4 style="font-size: 14px; font-weight: 800; color: #111827; margin: 20px 0 10px 0;">Message Content</h4>
      <div style="background: #f4f4f7; padding: 20px; border-radius: 8px; color: #1f2937; line-height: 1.6; white-space: pre-wrap;">
        {{raw:message}}
      </div>

      <!-- Commented out to remove the action button from the template
      <!-- Commented out to remove the action button from the template
      <div style="margin-top: 30px; text-align: center;">
        <a href="https://admin.royaltravel.mu/inquiries" class="button">View in Dashboard</a>
      </div>
      -->
      -->
    ', '["customer_name", "destination", "customer_email", "customer_phone", "departure_date", "adults", "children", "message"]', '2026-04-01 07:15:59.288165', '2026-05-05 16:45:09.446845'),
('e643e243-89de-4379-8b91-9aec6843d9fb', 'admin_new_booking', '🚨 NEW BOOKING: {{customer_name}} - {{service_name}}', '
      <h1 style="color: #111827; font-size: 24px; font-weight: 800; margin-bottom: 16px;">New Booking Received</h1>
      <p>A new reservation has been made on the website.</p>
      
      <div class="booking-details">
        <h4 style="margin: 0 0 15px 0; font-size: 14px; color: #DC2626; text-transform: uppercase; letter-spacing: 1px;">Customer Details</h4>
        <div class="detail-row">
            <span class="detail-label">Name</span>
            <span class="detail-value">{{customer_name}}</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Email</span>
            <span class="detail-value">{{customer_email}}</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Phone</span>
            <span class="detail-value">{{customer_phone}}</span>
        </div>
      </div>

      <div class="booking-details">
        <h4 style="margin: 0 0 15px 0; font-size: 14px; color: #DC2626; text-transform: uppercase; letter-spacing: 1px;">Trip Details</h4>
        <div class="detail-row">
            <span class="detail-label">Service</span>
            <span class="detail-value">{{service_name}}</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">{{label_start}}</span>
            <span class="detail-value">{{check_in}}</span>
        </div>
        <div style="display: {{show_checkout}}">
            <div class="detail-row">
                <span class="detail-label">{{label_end}}</span>
                <span class="detail-value">{{check_out}}</span>
            </div>
        </div>
        <div class="detail-row">
            <span class="detail-label">Guests</span>
            <span class="detail-value">{{adults}}A, {{teens}}T, {{children}}C, {{infants}}I</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Meal Plan</span>
            <span class="detail-value">{{meal_preference}}</span>
        </div>
        <div class="detail-row" style="border-bottom: none; padding-top: 15px;">
            <span class="detail-label" style="color: #111827; font-size: 14px;">Total Price</span>
            <span class="detail-value" style="color: #DC2626; font-size: 18px; font-weight: 800;">{{total_price}}</span>
        </div>
      </div>

      <h4 style="font-size: 14px; font-weight: 800; color: #111827; margin: 20px 0 10px 0;">Special Requests / Notes</h4>
      <div style="background: #fdf2f2; padding: 15px; border-radius: 8px; font-style: italic; color: #991b1b; font-size: 14px;">
        {{notes}}
      </div>

      <div style="margin-top: 30px; text-align: center;">
        <a href="https://admin.royaltravel.mu/inquiries" class="button">Process in Admin Console</a>
      </div>
    ', '{"amount": "Amount", "booking_id": "Ref", "service_name": "Service", "customer_name": "Name", "customer_email": "Email"}', '2026-03-31 17:07:39.778173', '2026-05-05 16:45:08.83452')
ON CONFLICT DO NOTHING;

