-- Data for services (34 rows)
INSERT INTO public."services" ("id", "name", "description", "location", "region", "rating", "image_url", "amenities", "service_type", "duration_days", "duration_hours", "max_group_size", "created_at", "updated_at", "room_types", "itinerary", "stock", "status", "cta_text", "cta_link", "gallery_images", "meta_title", "meta_description", "seo_keywords", "special_features", "seasonality", "highlights", "included", "not_included", "cancellation_policy", "terms_and_conditions", "thumbnail_url", "banner_url", "featured", "priority", "secondary_image_url", "is_seasonal_deal", "deal_note", "is_active", "is_coming_soon", "short_description", "max_adults", "max_children", "child_age_limit", "meal_plans", "activity_type", "service_fee", "badge_text") VALUES
('876b3848-829c-4bbe-8b8d-2f89158d2fee', ' Bali Package', '<ul><li>4&nbsp;Nights&nbsp;Stay&nbsp;at&nbsp;Grand&nbsp;Mega&nbsp;Resort&nbsp;&amp;&nbsp;Spa&nbsp;Bali&nbsp;or&nbsp;Similar</li><li>2&nbsp;Nights&nbsp;Stay&nbsp;at&nbsp;Full&nbsp;Moon&nbsp;Villa&nbsp;Ubud&nbsp;or&nbsp;Similar</li><li>Daily&nbsp;Bed&nbsp;&amp;&nbsp;Breakfast</li><li>Return&nbsp;Airport&nbsp;Transfers</li><li>Water&nbsp;Sports&nbsp;Activities&nbsp;(Banana&nbsp;Boat,&nbsp;Parasailing&nbsp;or&nbsp;Jet&nbsp;Ski)</li><li>Uluwatu&nbsp;Temple&nbsp;Tour</li><li>West&nbsp;Nusa&nbsp;Penida&nbsp;Day&nbsp;Trip&nbsp;(Kelingking&nbsp;Beach,&nbsp;Broken&nbsp;Beach&nbsp;&amp;&nbsp;Crystal&nbsp;Bay)&nbsp;with&nbsp;Local&nbsp;Lunch</li><li>Ulun&nbsp;Danu&nbsp;Beratan&nbsp;Temple,&nbsp;Handara&nbsp;Gate&nbsp;&amp;&nbsp;Taman&nbsp;Ayun&nbsp;Temple&nbsp;Tour</li><li>Kintamani&nbsp;(Mount&nbsp;Batur&nbsp;View&nbsp;Point),&nbsp;Coffee&nbsp;Plantation&nbsp;&amp;&nbsp;Ubud&nbsp;Art&nbsp;Market&nbsp;Visit</li><li>My&nbsp;Swing&nbsp;Experience&nbsp;(Swing&nbsp;&amp;&nbsp;Bird&nbsp;Nest)</li><li>One&nbsp;Full&nbsp;Day&nbsp;Free&nbsp;for&nbsp;Leisure</li></ul><p></p><p></p><pre data-language="plain">
Experience the magical beauty of Bali with a perfect blend of adventure, culture, and relaxation. From exciting water sports and breathtaking island tours to iconic temples, scenic mountain views, and the charming atmosphere of Ubud, this getaway offers unforgettable moments at every step. Enjoy comfortable stays, daily breakfast, guided excursions, and leisure time while discovering the tropical paradise of Bali.
</pre>', 'BALI', 'INDONESIA', '4.5', 'services/1778141668333-ba4j4w1dhbg.jpg', '[]', 'packages', NULL, NULL, NULL, '2026-05-07 08:24:51.782+00', '2026-05-08 06:10:56.804+00', '[]', '[]', NULL, 'active', NULL, NULL, '["services/1778146771469-5vjkl605kg.jpg"]', '', '', NULL, '[]', NULL, '["Cost of package per person sharing double room"]', '[""]', '["Exclude Air ticket & Visa for Bali "]', NULL, '<p><span style="color: rgb(34, 34, 34); background-color: rgb(255, 255, 255);">*&nbsp;Conditions&nbsp;apply,&nbsp;subject&nbsp;to&nbsp;availability.</span></p>', NULL, 'services/1778147457757-ptfe85oreh8.jpg', False, 0, 'services/1778146714138-jb44rlnpzf.jpg', False, 'Limited Time', True, False, 'Escape to Bali — where tropical adventures, breathtaking temples, and island paradise create the perfect unforgettable getaway.', NULL, NULL, 12, '[]', NULL, '0', 'ABROAD'),
('ffccd842-fc1c-4d0d-9781-9a03bd87ab66', 'Coral Azur Beach Resort', '<p><span style="background-color: rgb(255, 255, 255); color: rgb(102, 102, 102);">At&nbsp;Coral&nbsp;Azur&nbsp;Beach&nbsp;Resort,&nbsp;we&nbsp;take&nbsp;your&nbsp;holidays&nbsp;seriously!&nbsp;For&nbsp;the&nbsp;last&nbsp;thirty&nbsp;years,&nbsp;our&nbsp;ethos&nbsp;is&nbsp;to&nbsp;make&nbsp;every&nbsp;holiday&nbsp;one&nbsp;to&nbsp;remember&nbsp;with&nbsp;our&nbsp;caring&nbsp;and&nbsp;personalized&nbsp;service,&nbsp;delivered&nbsp;by&nbsp;a&nbsp;team&nbsp;of&nbsp;passionate&nbsp;team&nbsp;members.&nbsp;Authentic&nbsp;warmth&nbsp;and&nbsp;generosity,&nbsp;this&nbsp;is&nbsp;what&nbsp;drives&nbsp;each&nbsp;member&nbsp;of&nbsp;the&nbsp;hotel&nbsp;each&nbsp;day!&nbsp;While&nbsp;complying&nbsp;to&nbsp;high-quality&nbsp;hospitality&nbsp;standards,&nbsp;they&nbsp;are&nbsp;on&nbsp;a&nbsp;mission:&nbsp;meet&nbsp;all&nbsp;your&nbsp;needs&nbsp;while&nbsp;making&nbsp;sure&nbsp;you&nbsp;experience&nbsp;the&nbsp;local&nbsp;Art&nbsp;of&nbsp;living!</span></p>', 'Mont Choisy', 'North Coast', '4.5', 'services/1778142053864-dmz0aso11r.jpg', '["Free Wifi", "spa", "land and water activities", "kids club", "Bar and Restaurant", "Entertainment"]', 'hotel', NULL, NULL, NULL, '2026-05-07 08:27:50.053+00', '2026-05-07 08:27:50.053+00', '[]', '[]', NULL, 'active', NULL, NULL, '["services/1778142391661-kzd3vfbwi0q.webp", "services/1778142402034-sboptk11pjh.jpg", "services/1778142412791-4c2s5nn0mng.jpg", "services/1778142423685-a1jyazc2v9f.webp", "services/1778142439699-7tocqwz81ks.jpg", "services/1778142449010-705ytzwqus.jpg", "services/1778142461837-ou0v6phmdqn.webp"]', '', '', NULL, '[]', NULL, '[]', '[]', '[]', NULL, NULL, NULL, 'services/1778142013449-3ge6in90ph.webp', False, 0, 'services/1778142025807-vrwjihzuz5.jpg', False, 'Limited Time', True, False, 'Coral Azur Beach Resort is a beachfront hotel in Mauritius with a pool, restaurant, and comfortable rooms. It is ideal for a relaxing holiday.', NULL, NULL, 12, '[{"id": "1778144855303", "label": "Half Board"}, {"id": "1778144861063", "label": "Full Board"}]', NULL, '0', NULL),
('04455035-b740-4b26-bcd8-bad0d6e207b7', ' Dubai & Malaysia Group Tour', '<ul><li>Air&nbsp;Ticket&nbsp;With&nbsp;Emirates&nbsp;</li><li>4&nbsp;Nights&nbsp;Stay&nbsp;In&nbsp;Dubai&nbsp;At&nbsp;Hyatt&nbsp;Al&nbsp;Wasl,&nbsp;4*&nbsp;Or&nbsp;Similar&nbsp;</li><li>Daily&nbsp;Breakfast</li><li>Return&nbsp;Airport&nbsp;Transfer</li><li>Desert&nbsp;Safari&nbsp;With&nbsp;Bbq&nbsp;Dinner</li><li>Marina&nbsp;Dhow&nbsp;Cruise&nbsp;With&nbsp;Dinner&nbsp;</li><li>Dubai&nbsp;Half&nbsp;Day&nbsp;City&nbsp;Tour</li><li>6&nbsp;Nights&nbsp;Stay&nbsp;In&nbsp;Malaysia&nbsp;At&nbsp;Royal&nbsp;Hotel,&nbsp;4*&nbsp;Or&nbsp;Similar</li><li>Daily&nbsp;Breakfast</li><li>Return&nbsp;Airport&nbsp;Transfer</li><li>Full&nbsp;Day&nbsp;Genting&nbsp;Highland&nbsp;Tour&nbsp;With&nbsp;Cable&nbsp;Car&nbsp;Ticket&nbsp;</li><li>Half&nbsp;Day&nbsp;City&nbsp;Tour&nbsp;</li></ul><p></p><pre data-language="plain">
Discover the perfect blend of luxury, adventure, and culture with our Dubai &amp; Malaysia Group Tour. 
From dazzling city skylines to breathtaking attractions and unforgettable experiences, this journey promises memories that will last a lifetime.
</pre>', NULL, 'Dubai & Malaysia', '4.5', 'services/1778240525322-73xhcapwrjf.jpeg', '[]', 'tour', NULL, NULL, NULL, '2026-05-08 11:39:33.492+00', '2026-05-08 11:48:28.648+00', '[]', '[{"day": "Day 1", "time": "", "title": "Arrive Airport Dubai, Meet & Greet by our representative ", "image_url": "", "description": ""}, {"day": "Day 2", "time": "", "title": "Morning Free and at around 14h30, Desert Safari with BBQ dinner including return transfer", "image_url": "", "description": ""}, {"day": "Day 3", "time": "", "title": "Half day city tour and at around 18h00, Marina Dhow cruise with dinner including return transfer", "image_url": "", "description": ""}, {"day": "Day 4", "time": "", "title": "Free for leisure ", "image_url": "", "description": ""}, {"day": "Day 5", "time": "", "title": "Dubai \u2013 Malaysia , flight will be at night ", "image_url": "", "description": ""}, {"day": "Day 6", "time": "", "title": "Arrive Malaysia Airport , Meet & Greet by our representative ", "image_url": "", "description": ""}, {"day": "Day 7", "time": "", "title": "Half day city tour and Batu Caves ", "image_url": "", "description": ""}, {"day": "Day 8", "time": "", "title": "Full day Genting Highlands ", "image_url": "", "description": ""}, {"day": "Day 9", "time": "", "title": "Free for leisure ", "image_url": "", "description": ""}, {"day": "Day 10", "time": "", "title": "Departure from Malaysia \u2013 Mauritius", "image_url": "", "description": ""}]', NULL, 'active', NULL, NULL, '[]', '', '', NULL, '[]', NULL, '["Travelling date: 11 \u2013 23 Dec 2026", "Cost of package per adult on double sharing"]', '[]', '[]', NULL, '<p><span style="background-color: rgb(255, 255, 255); color: rgb(34, 34, 34);">Conditions&nbsp;apply,&nbsp;subject&nbsp;to&nbsp;availability</span></p>', NULL, 'services/1778240897192-2zsfn2jov9y.webp', False, 0, 'services/1778240596524-cbz93np9wtm.jpg', False, 'Limited Time', True, False, 'Two destinations, one unforgettable journey — Experience the best of Dubai & Malaysia with our exclusive group tour!', NULL, NULL, 12, '[]', NULL, '0', NULL),
('6043c9ce-afa7-4fb1-a27e-4aaafca39785', 'Friday Attitude', '<p><span style="color: rgb(78, 89, 101); background-color: rgb(228, 237, 234);">The&nbsp;hotel&nbsp;is&nbsp;located&nbsp;in&nbsp;eastern&nbsp;Mauritius&nbsp;near&nbsp;Trou&nbsp;d’Eau&nbsp;Douce,&nbsp;a&nbsp;fishing&nbsp;village&nbsp;where&nbsp;colourful&nbsp;boats&nbsp;move&nbsp;with&nbsp;the&nbsp;tides.&nbsp;</span><strong style="color: rgb(78, 89, 101); background-color: rgb(228, 237, 234);">In&nbsp;short:&nbsp;peaceful.</strong></p><p><span style="color: rgb(78, 89, 101); background-color: rgb(228, 237, 234);">Just&nbsp;north&nbsp;of&nbsp;the&nbsp;hotel,&nbsp;Belle&nbsp;Mare&nbsp;stretches&nbsp;out&nbsp;its&nbsp;white-sand&nbsp;carpet,&nbsp;and&nbsp;the&nbsp;wilder&nbsp;Bras&nbsp;d’Eau&nbsp;forest&nbsp;invites&nbsp;shady&nbsp;walks&nbsp;under&nbsp;filao&nbsp;trees.&nbsp;Right&nbsp;across&nbsp;the&nbsp;lagoon,&nbsp;Île&nbsp;aux&nbsp;Cerfs&nbsp;–&nbsp;reachable&nbsp;by&nbsp;boat&nbsp;–&nbsp;offers&nbsp;golf&nbsp;by&nbsp;the&nbsp;water&nbsp;and&nbsp;hidden&nbsp;coves.&nbsp;Then&nbsp;there’s&nbsp;Flacq,&nbsp;with&nbsp;its&nbsp;buzzing&nbsp;open-air&nbsp;market,&nbsp;fragrant&nbsp;spices,&nbsp;and&nbsp;colourful&nbsp;fruit&nbsp;stalls.&nbsp;</span><strong style="color: rgb(78, 89, 101); background-color: rgb(228, 237, 234);">A&nbsp;vibrant&nbsp;taste&nbsp;of&nbsp;Mauritius</strong><span style="color: rgb(78, 89, 101); background-color: rgb(228, 237, 234);">.</span></p><p></p><p>CHECK&nbsp;IN&nbsp;:&nbsp;14&nbsp;HRS</p><p>CHECK&nbsp;OUT&nbsp;:&nbsp;12&nbsp;HRS</p>', 'Trou d''eau Douces', 'East Coast', '4.5', 'services/1777875347127-imon16godop.jpg', '["Free wifi", "swimming pool", "Restaurant & bar", "kids club", "spa", "Land activities", "evening entertainment", "yoga and meditation", "water activities", "fREE Beach towels & mineral sunscreen", "Baby-sitting service", "LAUNDRY SERVICES", "Foreign currency exchange", "PARKING", "Shower and luggage rooms"]', 'hotel', NULL, NULL, NULL, '2026-05-04 06:16:38.31+00', '2026-05-04 09:57:52.31+00', '[]', '[]', NULL, 'active', NULL, NULL, '["services/1777875524887-3j54xyzmkh9.webp", "services/1777875540500-1eamnrud6c5.jpg", "services/1777875557502-zszryp1xcnd.jpg", "services/1777875568661-z72xqeowll.jpg", "services/1777875577437-r2wwwm6ezvk.jpg", "services/1777875588071-hjmjmevly8.png", "services/1777875607593-agqfkdqdgd.jpg", "services/1777875618274-utom0dm70w.jpg", "services/1777875636577-7r3mw70ddm8.jpg", "services/1777875646199-hjaykksr48.jpg"]', '', '', NULL, '[]', NULL, '[]', '[]', '[]', '<p>&nbsp;</p><p>Cancellation&nbsp;Policy</p><p>The&nbsp;applicable&nbsp;cancellation&nbsp;policy&nbsp;shall&nbsp;be&nbsp;as&nbsp;follows&nbsp;:</p><p>Cancellation&nbsp;date/period&nbsp;</p><p>Rate&nbsp;payable</p><p>Between&nbsp;D-7&nbsp;and&nbsp;D-4&nbsp;:&nbsp;50%&nbsp;of&nbsp;total&nbsp;rate&nbsp;payable</p><p>Between&nbsp;D-3&nbsp;and&nbsp;D-1:&nbsp;&nbsp;80%&nbsp;of&nbsp;total&nbsp;rate&nbsp;payable</p><p>Peak&nbsp;season&nbsp;between&nbsp;D-30&nbsp;and&nbsp;D-1:&nbsp;100%&nbsp;of&nbsp;total&nbsp;rate&nbsp;payable</p><p>No&nbsp;shows:&nbsp;100%&nbsp;of&nbsp;total&nbsp;rate&nbsp;payable</p><p>Unexpected&nbsp;departure:&nbsp;No&nbsp;refund.&nbsp;</p><p>&nbsp;</p><p></p>', '<p>Rates&nbsp;are&nbsp;in&nbsp;MUR&nbsp;per&nbsp;room&nbsp;per&nbsp;night&nbsp;on&nbsp;&#39;Half&nbsp;Board&#39;&nbsp;basis&nbsp;[&nbsp;Breakfast&nbsp;&amp;&nbsp;Dinner&nbsp;].</p><p></p><p>Children&nbsp;who&nbsp;are&nbsp;less&nbsp;than&nbsp;3&nbsp;years&nbsp;old&nbsp;are&nbsp;FOC&nbsp;on&nbsp;parents&nbsp;meal&nbsp;plan&nbsp;booked.</p><p></p><p>A&nbsp;minimum&nbsp;of&nbsp;2&nbsp;children/teens&nbsp;is&nbsp;required&nbsp;per&nbsp;room&nbsp;for&nbsp;children/teens&nbsp;in&nbsp;their&nbsp;own&nbsp;room.</p><p></p><p>Single&nbsp;Parent&nbsp;Policy&nbsp;:&nbsp;1&nbsp;Adult&nbsp;+&nbsp;1&nbsp;Teen&nbsp;=&nbsp;Pays&nbsp;2&nbsp;*&nbsp;1/2&nbsp;Double.</p><p></p><p>Minimum&nbsp;of&nbsp;2-nights&nbsp;stay&nbsp;for&nbsp;All&nbsp;inclusive&nbsp;basis&nbsp;and&nbsp;Half&nbsp;&amp;&nbsp;Full&nbsp;board&nbsp;basis&nbsp;for&nbsp;1&nbsp;night&nbsp;stay</p><p>&nbsp;</p><p>&nbsp;</p>', NULL, 'services/1777875373855-81v2qffrc1h.jpg', False, 0, 'services/1777875389421-e2a34ouhhkm.jpg', False, 'Limited Time', True, False, 'Some holidays are for running around, planning, seeing every possible sight. Then there are holidays at Friday Attitude in Mauritius. Here, there’s no fuss, just freedom and an easy life. The vibe is set.

Oh wait, it’s Friday.', NULL, NULL, 12, '[{"id": "1777981719286", "label": "Half Board"}, {"id": "1777981722182", "label": "All Inclusive"}]', NULL, '0', NULL),
('7a0685ed-fa2e-43f2-9711-eeebf53d3f48', 'Anelia Resort & Spa', '<h4 class="ql-align-center"><strong style="background-color: rgb(255, 255, 255); color: rgb(0, 0, 0);">With&nbsp;a&nbsp;room&nbsp;capacity&nbsp;of&nbsp;141,&nbsp;Anelia&nbsp;Resort&nbsp;offers&nbsp;a&nbsp;panoply&nbsp;of&nbsp;accommodation&nbsp;ranging&nbsp;from&nbsp;individual&nbsp;villas&nbsp;set&nbsp;in&nbsp;an&nbsp;authentic&nbsp;“village&nbsp;creole”,&nbsp;guest&nbsp;rooms&nbsp;in&nbsp;typical&nbsp;Mauritian&nbsp;architecture&nbsp;to&nbsp;the&nbsp;new&nbsp;superior&nbsp;rooms&nbsp;designed&nbsp;in&nbsp;modern&nbsp;and&nbsp;contemporary&nbsp;style.&nbsp;Come&nbsp;and&nbsp;make&nbsp;at&nbsp;Anelia,&nbsp;a&nbsp;catching&nbsp;discovery&nbsp;where&nbsp;old&nbsp;blends&nbsp;with&nbsp;new&nbsp;and&nbsp;experience&nbsp;the&nbsp;evolutionary&nbsp;development&nbsp;of&nbsp;Mauritian&nbsp;living&nbsp;over&nbsp;the&nbsp;past&nbsp;century.</strong></h4><p class="ql-align-center"></p><p class="ql-align-center">Check&nbsp;in&nbsp;time:&nbsp;14hr00</p><p class="ql-align-center">Check&nbsp;out&nbsp;time:&nbsp;11hr00.</p>', 'Flic en Flac', 'West Coast', '4.5', 'services/1777546582110-44wzsj7d3ky.jpg', '["Free Wi-Fi", "Fitness centre", "Restaurants & bars", "Spa & wellness centre", "Swimming pools", "Beachfront location with direct beach access", "Kids club", "Entertainment & games"]', 'hotel', NULL, NULL, NULL, '2026-04-30 11:06:23.623+00', '2026-05-07 06:16:53.85+00', '[]', '[]', NULL, 'active', NULL, NULL, '["services/1777546956447-i7glndb0mid.jpg", "services/1777546987040-t4htt4zw9t.jpg", "services/1777547000145-opmqdrydbhe.jpg", "services/1777547010577-m6p414trrep.jpg", "services/1777547019120-u419c0ijr1.jpg", "services/1777547117167-dh1itxzwrq.webp", "services/1777547140865-qz9itc0ukur.webp"]', '', '', NULL, '[]', NULL, '[]', '["Breakfast : Buffet at La Toque Blanche Restaurant (07 :30 \u2013 10 :00)", "Lunch : Buffet at La Toque Blanche Restaurant (12 :30 \u2013 14 :30)", "Selected drinks: locally bottled spirits, beers, soft drinks & selected cocktails served at the bar (10:30 -22:30)", "Selection of sweets and salty bites including tea/coffee (16:00 \u2013 17:00)", "Dinner: Buffet at La Toque Blanche Restaurant ( 19 :00 \u2013 22 :00)"]', '["Mini bar is not included"]', '<p>•&nbsp;Free&nbsp;Cancellation&nbsp;7&nbsp;days&nbsp;prior&nbsp;to&nbsp;arrival&nbsp;date</p><p>•&nbsp;D-6&nbsp;/&nbsp;D-1&nbsp;&amp;&nbsp;NO&nbsp;Show&nbsp;–&nbsp;Full&nbsp;Cancellation&nbsp;fee&nbsp;shall&nbsp;be&nbsp;applicable.</p>', '<ul><li>Applicable&nbsp;to&nbsp;Mauritian&nbsp;citizens&nbsp;only</li></ul>', NULL, 'services/1777546596690-4qpv1d8mmbp.jpg', False, 0, 'services/1777546617848-gjt0knu0x7.jpg', False, 'Limited Time', True, False, 'Anelia Resort & Spa is a beachfront hotel on Mauritius’s west coast, offering comfortable rooms, pools, a spa, and direct lagoon access—ideal for a relaxing stay for couples and families.', NULL, NULL, 12, '[{"id": "1777639255205", "label": "All Inclusive"}]', NULL, '0', NULL),
('5fdf3baf-e944-4d53-893c-138a8e72fd71', 'Bangkok Group Tour ', '<ul><li>Air&nbsp;Ticket&nbsp;With&nbsp;Air&nbsp;Austral&nbsp;</li><li>7&nbsp;Nights&nbsp;Stay&nbsp;At&nbsp;Century&nbsp;Park&nbsp;Hotel,&nbsp;4*&nbsp;Or&nbsp;Similar&nbsp;</li><li>Daily&nbsp;Breakfast</li><li>Return&nbsp;Airport&nbsp;Transfer</li><li>Half&nbsp;City&nbsp;Tour</li><li>Chao&nbsp;Praya&nbsp;Dinner&nbsp;Cruise</li><li>Floating&nbsp;Market</li><li>Pattaya&nbsp;Full&nbsp;Day&nbsp;Tour&nbsp;From&nbsp;Bangkok&nbsp;-&nbsp;Pattaya&nbsp;City&nbsp;Tour&nbsp;+&nbsp;Half&nbsp;Day&nbsp;Elephant&nbsp;Sanctuary&nbsp;With&nbsp;Local&nbsp;Lunch&nbsp;+&nbsp;Sanctuary&nbsp;Of&nbsp;Truth&nbsp;</li></ul><p></p><pre data-language="plain">
Discover the vibrant energy of Bangkok on an unforgettable group tour filled with culture, shopping, and iconic city experiences. From dazzling temples to lively street markets, every moment is a journey into the heart of Thailand’s capital.
</pre>', 'PATTAYA', 'BANGKOK', '4.5', 'services/1778242164887-unf3y0ifjl.jpg', '[]', 'tour', NULL, NULL, NULL, '2026-05-08 12:09:34.625+00', '2026-05-08 12:11:34.665+00', '[]', '[{"day": "Day 1", "time": "", "title": "Arrive Airport, Meet & Greet by our representative, at around 17h30, Chaophraya dinner cruise including return transfer", "image_url": "", "description": ""}, {"day": "Day 2", "time": "", "title": "Temple & Half Day city tour and afternoon free for leisure ", "image_url": "", "description": ""}, {"day": "Day 3", "time": "", "title": "Full day Pattaya, City tour, elephant sanctuary and Sanctuary of Truth ", "image_url": "", "description": ""}, {"day": "Day 4", "time": "", "title": "Free for leisure ", "image_url": "", "description": ""}, {"day": "Day 5", "time": "", "title": "Floating Market & Railway, afternoon free for leisure", "image_url": "", "description": ""}, {"day": "Day 6", "time": "", "title": "Free for leisure", "image_url": "", "description": ""}, {"day": "Day 7", "time": "", "title": "Free for leisure", "image_url": "", "description": ""}, {"day": "Day 8", "time": "", "title": "Departure from Bangkok \u2013 Mauritius ", "image_url": "", "description": ""}]', NULL, 'active', NULL, NULL, '[]', '', '', NULL, '[]', NULL, '["Travelling date : 18 \u2013 26 Nov 2026", "Cost of package per adult on double "]', '[]', '[]', NULL, '<p><span style="color: rgb(34, 34, 34); background-color: rgb(255, 255, 255);">Conditions&nbsp;apply,&nbsp;subject&nbsp;to&nbsp;availability</span></p>', NULL, 'services/1778241894584-2xp13bce4ga.jpg', False, 0, 'services/1778241904558-ps5noetv6qn.jpg', False, 'Limited Time', True, False, 'Discover the vibrant charm of Bangkok — where culture, shopping, nightlife, and unforgettable adventures come together!', NULL, NULL, 12, '[]', NULL, '0', NULL),
('d38f9018-55e1-4fef-b0c3-c71fb3e44fbb', 'Sea Diamond Boutique Hotel & Spa', '<p>Sea&nbsp;Diamond&nbsp;Boutique&nbsp;Hotel&nbsp;&amp;&nbsp;Spa&nbsp;is&nbsp;a&nbsp;five-star&nbsp;relaxed&nbsp;luxury&nbsp;boutique&nbsp;hotel&nbsp;nested&nbsp;on&nbsp;Calodyne&nbsp;Beach&nbsp;of&nbsp;the&nbsp;multiple&nbsp;turquoise&nbsp;colours&nbsp;of&nbsp;the&nbsp;Indian&nbsp;Ocean&nbsp;and&nbsp;overlooking&nbsp;the&nbsp;spectacular&nbsp;view&nbsp;of&nbsp;the&nbsp;five&nbsp;islets&nbsp;of&nbsp;the&nbsp;north-east&nbsp;of&nbsp;Mauritius.&nbsp;This&nbsp;new&nbsp;boutique&nbsp;hotel&nbsp;offers&nbsp;73&nbsp;luxurious&nbsp;Suites&nbsp;in&nbsp;lush&nbsp;greenery,&nbsp;2&nbsp;restaurants&nbsp;(main&nbsp;restaurant&nbsp;of&nbsp;150&nbsp;covers&nbsp;and&nbsp;a&nbsp;fine&nbsp;dining&nbsp;restaurant&nbsp;of&nbsp;30&nbsp;covers),&nbsp;a&nbsp;pool&nbsp;bar,&nbsp;a&nbsp;spa&nbsp;village,&nbsp;a&nbsp;gym,&nbsp;a&nbsp;library&nbsp;and&nbsp;a&nbsp;boathouse,&nbsp;ideal&nbsp;for&nbsp;a&nbsp;peaceful&nbsp;and&nbsp;relaxing&nbsp;beach&nbsp;holiday&nbsp;experience.</p><p></p><p>CHECK&nbsp;IN&nbsp;:&nbsp;14HRS</p><p>CHECK&nbsp;OUT&nbsp;:&nbsp;11HRS30</p>', 'Calodyne', 'North Coast', '4.5', 'services/1778227021234-6upq2x5t1wl.webp', '[]', 'hotel', NULL, NULL, NULL, '2026-05-08 07:15:47.624+00', '2026-05-08 07:57:07.745+00', '[]', '[]', NULL, 'active', NULL, NULL, '["services/1778224405227-iwt40dz99q.webp", "services/1778224416590-5w1tp89jnrj.webp", "services/1778224431486-3rdpdca5hky.webp", "services/1778224446460-w1x96bauvoo.webp", "services/1778224456598-nkxj2zy0pli.webp", "services/1778224468172-zsr5d1rgtqh.webp", "services/1778224487113-0gqrqmsqtudw.webp", "services/1778224501164-ulxm56ws3xm.webp", "services/1778224511394-4r89xnle0ij.webp", "services/1778224530787-b6hlq4ua5pt.jpg"]', '', '', NULL, '[]', NULL, '[]', '[]', '[]', NULL, NULL, NULL, 'services/1778224308570-00oy20hxklhbn.webp', False, 0, 'services/1778224323165-z4y5bvpz67e.jpg', False, 'Limited Time', True, False, 'Sea Diamond Boutique Hotel & Spa is a 5-star beachfront luxury resort in Calodyne, Mauritius with suites, spa, pools, and ocean views.', NULL, NULL, 12, '[{"id": "1778224785800", "label": "Half Board"}]', NULL, '0', NULL),
('a1fdbe71-8d9f-4087-8821-512176afa629', 'Swimming with Wild Dolphins', '<p>Join&nbsp;us&nbsp;for&nbsp;an&nbsp;early&nbsp;morning&nbsp;boat&nbsp;trip&nbsp;to&nbsp;meet&nbsp;the&nbsp;wild&nbsp;spinner&nbsp;and&nbsp;bottlenose&nbsp;dolphins&nbsp;in&nbsp;their&nbsp;natural&nbsp;habitat&nbsp;along&nbsp;the&nbsp;West&nbsp;coast.</p>', 'Tamarin', 'West', '4.9', 'https://images.unsplash.com/photo-1570481662006-a3a1374699e8?auto=format&fit=crop&q=80', '["Snorkeling", "Boat Trip", "Dolphins"]', 'activity', NULL, NULL, NULL, '2026-04-27 07:12:37.995953+00', '2026-04-30 09:04:27.488+00', '[]', '[]', NULL, 'active', NULL, NULL, '[]', '', '', NULL, '[]', NULL, '["Wild Dolphin Encounter", "Snorkeling Equipment", "Crystal Rock Visit"]', '["Boat Transfer", "Breakfast", "Snorkel Gear"]', '[]', NULL, NULL, NULL, '', False, 0, '', False, 'Limited Time', True, False, 'Unforgettable ocean encounter.', NULL, NULL, 12, '[{"id": "1777736474809", "label": "All Inclusive"}]', 'Sea', '0', NULL),
('2d0aa5d7-85f9-429d-8771-40f867a1c7c1', 'Promo Australia on Air Mauritius ', '<p><strong>Australia&nbsp;Special&nbsp;Offers&nbsp;</strong></p><p></p><p><strong>Perth</strong></p><p>&nbsp;<em>From&nbsp;MUR&nbsp;54,500</em></p><p></p><p><strong>Adelaide&nbsp;/&nbsp;Brisbane&nbsp;/&nbsp;Sydney&nbsp;/&nbsp;Melbourne</strong></p><p>&nbsp;<em>From&nbsp;MUR&nbsp;73,000</em></p><p></p><p><strong>Sales&nbsp;Period:</strong>&nbsp;24&nbsp;April&nbsp;–&nbsp;22&nbsp;May&nbsp;2026</p><p><strong>Travel&nbsp;Period:</strong>&nbsp;30&nbsp;July&nbsp;2026&nbsp;–&nbsp;29&nbsp;October&nbsp;2026</p><p></p><p>&nbsp;<em>(Last&nbsp;return:&nbsp;29&nbsp;October&nbsp;2026)</em></p>', NULL, 'Mauritius', '4.5', 'services/1778051268177-l82ztpfjgcc.jpg', '[]', 'packages', NULL, NULL, NULL, '2026-05-06 07:25:04.61+00', '2026-05-07 07:54:26.65+00', '[]', '[{"day": "Day 1", "title": "", "image_url": "", "description": ""}]', NULL, 'active', NULL, NULL, '[]', '', '', NULL, '[]', NULL, '[]', '[]', '["*Exclude Service fee "]', NULL, '<p><span style="background-color: white; color: rgb(10, 10, 10);">*&nbsp;Conditions&nbsp;apply,&nbsp;subject&nbsp;to&nbsp;availability&nbsp;</span></p>', NULL, 'services/1778052290181-660ocoblud2.jpg', False, 0, '', True, 'Limited Time', True, False, '', NULL, NULL, 12, '[{"id": "1778076212481", "label": "Half Board"}]', NULL, '0', NULL),
('a69d35b2-8784-4ce6-8cfe-46b2ae2ce8de', 'Casuarina Resort and Spa', '<p><span style="color: rgb(92, 92, 92); background-color: rgb(255, 255, 255);">Nestled&nbsp;along&nbsp;a&nbsp;private&nbsp;beach&nbsp;in&nbsp;the&nbsp;picturesque&nbsp;Trou&nbsp;aux&nbsp;Biches,&nbsp;Casuarina&nbsp;Resort&nbsp;&amp;&nbsp;Spa&nbsp;offers&nbsp;the&nbsp;ultimate&nbsp;tropical&nbsp;escape&nbsp;with&nbsp;an&nbsp;outdoor&nbsp;pool,&nbsp;luxurious&nbsp;wellness&nbsp;center,&nbsp;and&nbsp;world-class&nbsp;dining.</span></p><p><span style="color: rgb(92, 92, 92); background-color: rgb(255, 255, 255);">Guests&nbsp;can&nbsp;choose&nbsp;from&nbsp;elegantly&nbsp;designed&nbsp;rooms&nbsp;and&nbsp;bungalows,&nbsp;each&nbsp;equipped&nbsp;with&nbsp;modern&nbsp;amenities&nbsp;like&nbsp;air&nbsp;conditioning,&nbsp;satellite&nbsp;TV,&nbsp;and&nbsp;private&nbsp;bathrooms.</span></p><p><span style="color: rgb(92, 92, 92); background-color: rgb(255, 255, 255);">Located&nbsp;just&nbsp;12&nbsp;miles&nbsp;from&nbsp;the&nbsp;vibrant&nbsp;capital,&nbsp;Port&nbsp;Louis,&nbsp;this&nbsp;resort&nbsp;blends&nbsp;relaxation&nbsp;with&nbsp;adventure,&nbsp;making&nbsp;it&nbsp;an&nbsp;ideal&nbsp;choice&nbsp;for&nbsp;travelers&nbsp;seeking&nbsp;a&nbsp;memorable&nbsp;Mauritian&nbsp;getaway.</span></p><p><span style="color: rgb(92, 92, 92); background-color: rgb(255, 255, 255);">Select&nbsp;accommodations&nbsp;also&nbsp;feature&nbsp;private&nbsp;balconies&nbsp;or&nbsp;terraces,&nbsp;offering&nbsp;stunning&nbsp;views&nbsp;of&nbsp;the&nbsp;surroundings.</span></p><p></p><p>CHECK&nbsp;IN&nbsp;:&nbsp;14&nbsp;HRS</p><p>CHECK&nbsp;OUT&nbsp;:&nbsp;12&nbsp;HRS</p>', 'Trou Aux Biches', 'Mauritius', '4.5', 'services/1777551247221-nwk1tuvbbh.jpg', '["Free Wifi", "Free Activities ", "gym", "spa", "Free Secured parking", "kids club", "swimming pool", "Free water sport", "restaurant & bar"]', 'hotel', NULL, NULL, NULL, '2026-04-30 12:23:22.591+00', '2026-05-02 07:39:46.631+00', '[]', '[]', NULL, 'active', NULL, NULL, '["services/1777551303027-8stpcg6t7lt.jpg", "services/1777551311615-saoj185d22.jpg", "services/1777551322011-fjfg5lfkyl.jpg", "services/1777551330135-ccdf1dyr368.jpg", "services/1777551340339-pzgwouuyigb.jpg", "services/1777551352035-p9chr2fm6sf.jpg", "services/1777551362374-q6gacpyq7d.jpg", "services/1777551374517-gq4e83qfndf.jpg"]', '', '', NULL, '[]', NULL, '[]', '["Breakfast (07.30-10.00)", "Lunch (12.00 to 13:45)", "Dinner (19.30-21.30)", "Drinks Unlimited Locally bottled spirit, beers,wine, soft drinks and juices.", "Starts at 14:00 on arrival with tea time + snacks and ends at 14:00 on check-out date.", "Daily: All-Inclusive starts as from 11:00 and ends at 23:00 p.m. daily during your stay"]', '[]', '<p>If&nbsp;Cancelled&nbsp;07&nbsp;Days&nbsp;prior&nbsp;to&nbsp;check&nbsp;in&nbsp;-&nbsp;100%&nbsp;Cancellation&nbsp;charges.</p>', '<p>1st&nbsp;Child&nbsp;Stay&nbsp;for&nbsp;Free&nbsp;and&nbsp;Eat&nbsp;for&nbsp;Free.&nbsp;</p><p>2&nbsp;Minimum&nbsp;Nights&nbsp;for&nbsp;May&nbsp;2026</p><p>3&nbsp;Minimum&nbsp;Nights&nbsp;June&nbsp;-&nbsp;September&nbsp;2026.</p>', NULL, 'services/1777551288872-g959xm2p2mi.jpg', False, 0, 'services/1777551279179-wmbdjcpe0l.jpg', False, 'Limited Time', True, False, 'Nestled along a private beach in the picturesque Trou aux Biches, Casuarina Resort & Spa offers the ultimate tropical escape with an outdoor pool, luxurious wellness center, and world-class dining.', NULL, NULL, 12, '[{"id": "1777708109641", "label": "All Inclusive"}]', NULL, '0', NULL),
('e1657beb-2495-41d4-9e5f-90b2a0f6d8a4', 'Tarisa Resort & Spa', '<p class="ql-align-center"><span style="color: rgb(102, 102, 102); background-color: rgb(255, 255, 255);">The&nbsp;recently&nbsp;renovated&nbsp;hotel&nbsp;offers&nbsp;modern&nbsp;comfort&nbsp;and&nbsp;amenities;&nbsp;two&nbsp;restaurants,&nbsp;one&nbsp;where&nbsp;its&nbsp;guests&nbsp;can&nbsp;discover&nbsp;a&nbsp;culinary&nbsp;variety&nbsp;of&nbsp;Mauritian&nbsp;and&nbsp;International&nbsp;cuisines&nbsp;and&nbsp;the&nbsp;other&nbsp;where&nbsp;they&nbsp;can&nbsp;enjoy&nbsp;the&nbsp;authentic&nbsp;Indian&nbsp;cuisine;&nbsp;a&nbsp;bar&nbsp;where&nbsp;its&nbsp;guests&nbsp;can&nbsp;sip&nbsp;on&nbsp;cocktails&nbsp;while&nbsp;overlooking&nbsp;the&nbsp;swimming&nbsp;pool&nbsp;and&nbsp;enjoying&nbsp;the&nbsp;sea&nbsp;view;&nbsp;relaxing&nbsp;spa&nbsp;treatments&nbsp;where&nbsp;one&nbsp;can&nbsp;unwind….</span></p><p class="ql-align-center"><span style="color: rgb(102, 102, 102); background-color: rgb(255, 255, 255);">Come&nbsp;and&nbsp;relax&nbsp;on&nbsp;the&nbsp;magnificent&nbsp;sandy&nbsp;beach&nbsp;of&nbsp;Mont&nbsp;Choisy.&nbsp;Its&nbsp;white&nbsp;thin&nbsp;sandy&nbsp;beach&nbsp;of&nbsp;approximately&nbsp;3&nbsp;km&nbsp;long&nbsp;will&nbsp;bring&nbsp;you&nbsp;into&nbsp;a&nbsp;realm&nbsp;of&nbsp;infinite&nbsp;dreams.</span></p><p class="ql-align-center"><span style="color: rgb(102, 102, 102); background-color: rgb(255, 255, 255);">At&nbsp;Tarisa&nbsp;Resort&nbsp;&amp;&nbsp;Spa,&nbsp;we&nbsp;also&nbsp;offer&nbsp;disabled-friendly&nbsp;room&nbsp;facilities.</span></p><p class="ql-align-center">Check&nbsp;in&nbsp;:&nbsp;14hrs</p><p class="ql-align-center">Check&nbsp;out&nbsp;:&nbsp;12hrs</p>', 'Mont Choisy', 'Mauritius', '4.5', 'services/1777549900199-otcr9lgn8b.jpg', '["free wifi", "Free Land & Water Sports", "Gym", "sauna", "spa", "daily entertainment ", "Mini club", "2 swimming pools (1 kid''s pool)", "jaccuzzi", "restaurant & bar", "babysitting services", "Laundry services"]', 'hotel', NULL, NULL, NULL, '2026-04-30 11:51:58.782+00', '2026-04-30 11:52:52.297+00', '[]', '[]', NULL, 'active', NULL, NULL, '["services/1777549695809-rcv16oxbz7r.jpg", "services/1777549717432-qbu20ij8d2.jpg", "services/1777549733008-qjjgvse2c7.jpg", "services/1777549741891-ulezavzrlw.jpg", "services/1777549750902-ea875n7ep5l.jpg", "services/1777549759420-1o3xyo7n3tc.jpg", "services/1777549787570-m537x615a3b.jpg"]', '', '', NULL, '[]', NULL, '[]', '[]', '[]', NULL, NULL, NULL, 'services/1777549912809-7w3932t2dcu.jpg', False, 0, 'services/1777549665008-25yqhwbls5j.jpg', False, 'Limited Time', True, False, 'Situated at a prime seaside location, the hotel gives direct access to one of the most popular sandy beaches of the island, where one can admire the magnificent warm turquoise lagoon, experience a selection of water sports activities whilst being in close proximity to local attractions', NULL, NULL, 12, '[{"id": "1778080139815", "label": "Full Board"}, {"id": "1778080147777", "label": "All Inclusive"}]', NULL, '0', NULL),
('3856e005-a39f-4064-b2e8-24ab91f3f919', 'Coin de Mire Attitude Hotel', '<p class="ql-align-center"><span style="background-color: rgb(251, 249, 238); color: rgb(78, 89, 101);">Situated&nbsp;on&nbsp;Mauritius’s&nbsp;northern&nbsp;tip,&nbsp;the&nbsp;3*+&nbsp;Coin&nbsp;de&nbsp;Mire&nbsp;Attitude&nbsp;hotel&nbsp;enjoys&nbsp;an&nbsp;exceptional&nbsp;position&nbsp;between&nbsp;</span><strong style="background-color: rgb(251, 249, 238); color: rgb(78, 89, 101);">Grand&nbsp;Baie</strong><span style="background-color: rgb(251, 249, 238); color: rgb(78, 89, 101);">,&nbsp;an&nbsp;unmissable&nbsp;and&nbsp;lively&nbsp;resort&nbsp;town,&nbsp;and&nbsp;the&nbsp;picturesque,&nbsp;fishing&nbsp;village&nbsp;of&nbsp;Cap&nbsp;Malheureux.</span></p><p class="ql-align-center"><span style="background-color: rgb(251, 249, 238); color: rgb(78, 89, 101);">Looking&nbsp;straight&nbsp;out&nbsp;to&nbsp;the&nbsp;island’s&nbsp;surrounding&nbsp;lagoon,&nbsp;Coin&nbsp;de&nbsp;Mire&nbsp;Attitude&nbsp;sits&nbsp;opposite&nbsp;the&nbsp;entrance&nbsp;to&nbsp;sandy&nbsp;Bain&nbsp;Boeuf&nbsp;beach.&nbsp;This&nbsp;</span><strong style="background-color: rgb(251, 249, 238); color: rgb(78, 89, 101);">peaceful&nbsp;cove&nbsp;</strong><span style="background-color: rgb(251, 249, 238); color: rgb(78, 89, 101);">offers&nbsp;splendid&nbsp;seas&nbsp;views&nbsp;over&nbsp;colourful&nbsp;fishing&nbsp;boats&nbsp;and&nbsp;turquoise&nbsp;waters&nbsp;towards&nbsp;the&nbsp;iconic&nbsp;coral&nbsp;island&nbsp;of</span><strong style="background-color: rgb(251, 249, 238); color: rgb(78, 89, 101);">&nbsp;Coin&nbsp;de&nbsp;Mire</strong><span style="background-color: rgb(251, 249, 238); color: rgb(78, 89, 101);">&nbsp;(or&nbsp;Gunner’s&nbsp;Quoin).</span></p><p class="ql-align-center"></p><p class="ql-align-center">Check-in&nbsp;time:&nbsp;14:00</p><p class="ql-align-center">Check-&nbsp;out&nbsp;time:&nbsp;12:00</p>', 'Cap Malheureux', 'Mauritius', '4.5', 'services/1777710848372-glrvltmgks.jpg', '["Free Wi-Fi", "Laundry (at extra cost)", "Free parking", "Beach towels and mineral sunscreen available for free", "AC in room", "Mobile device charging corner available at reception"]', 'hotel', NULL, NULL, NULL, '2026-05-02 08:53:47.937+00', '2026-05-07 07:08:59.754+00', '[]', '[]', NULL, 'active', NULL, NULL, '["services/1778137603818-9yquhz2foua.jpg", "services/1778137613023-nmz0dtkrh3.jpg", "services/1778137619463-e2r2xjyziec.jpg", "services/1778137637780-c4bmlxec7ja.jpg", "services/1778137649193-m93jezlgmh9.webp", "services/1778137662243-h0nddziz69m.webp", "services/1778137680612-fz94k2gtpcp.webp"]', '', '', NULL, '[]', NULL, '[]', '["Half Board (Breakfast and Dinner)", "All Inclusive (Breakfast, Lunch, dinner and Local Drinks)"]', '[]', '<p>Between&nbsp;D-7&nbsp;and&nbsp;D-4:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;50%&nbsp;of&nbsp;total&nbsp;rate&nbsp;payable&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</p><p>Between&nbsp;D-3&nbsp;and&nbsp;D-1:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;80%&nbsp;of&nbsp;total&nbsp;rate&nbsp;payable</p><p>Peak&nbsp;season&nbsp;between&nbsp;D-30&nbsp;and&nbsp;D-1:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;100%&nbsp;of&nbsp;total&nbsp;rate&nbsp;payable</p><p>No&nbsp;shows:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbs